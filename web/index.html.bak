<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport"
    content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="VYREN">
  <meta name="theme-color" content="#08080f">
  <link rel="manifest" href="/manifest.json">
  <link rel="icon"
    href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚡</text></svg>">
  <link rel="apple-touch-icon"
    href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 180 180'><rect fill='%2308080f' width='180' height='180' rx='40'/><text x='90' y='125' text-anchor='middle' font-size='110'>⚡</text></svg>">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="VYREN">
  <meta name="theme-color" content="#08080f">
  <title>VYREN</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js">
  </script>
  <style>
    /* ═══════════════════════════════════════════════════════════
   DESIGN TOKENS
   Palette: state colors are functional (map to voice states),
   not decorative. --signal is the one signature brand accent —
   used for identity/active-nav/orb-idle, never for state.
   Type: Space Grotesk (brand/headers) + Inter (body) + JetBrains
   Mono (telemetry/logs/data) — three roles, three jobs.
   ═══════════════════════════════════════════════════════════ */
    *,
    *::before,
    *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box
    }

    :root {
      --bg: #08080f;
      --bg2: #0d0d16;
      --bg3: #14141f;
      --bg-input: #0d0d18;
      --glass: rgba(18, 18, 28, .62);
      --glass-strong: rgba(20, 20, 32, .82);
      --border: rgba(255, 255, 255, .07);
      --border2: rgba(255, 255, 255, .14);

      --signal: #7c6cff;
      --signal-d: rgba(124, 108, 255, .14);
      --signal-glow: rgba(124, 108, 255, .28);
      --cyan: #00d4ff;
      --cyan-d: rgba(0, 212, 255, .15);
      --green: #00ff88;
      --green-d: rgba(0, 255, 136, .12);
      --amber: #ffaa00;
      --amber-d: rgba(255, 170, 0, .12);
      --red: #ff4466;
      --red-d: rgba(255, 68, 102, .12);

      --txt: #c8c8d4;
      --txt-h: #fdfdff;
      --txt-m: #6a6a80;
      --txt-dim: #454558;

      --r: 12px;
      --r-lg: 16px;
      --r-sm: 8px;
      --safe-top: env(safe-area-inset-top, 0px);
      --safe-bot: env(safe-area-inset-bottom, 0px);
      --orb-size: 176px;
      --topbar-h: 52px;
      --sidebar-w: 208px;
      --sidebar-w-collapsed: 60px;
      --right-w: 300px;

      --f-display: 'Space Grotesk', sans-serif;
      --f-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --f-mono: 'JetBrains Mono', 'SF Mono', Monaco, monospace;
    }

    html,
    body {
      height: 100%;
      font-family: var(--f-body);
      background: var(--bg);
      color: var(--txt);
      font-size: 14px;
      line-height: 1.5;
      overflow: hidden;
      -webkit-font-smoothing: antialiased;
      -webkit-tap-highlight-color: transparent
    }

    ::-webkit-scrollbar {
      width: 5px;
      height: 5px
    }

    ::-webkit-scrollbar-track {
      background: transparent
    }

    ::-webkit-scrollbar-thumb {
      background: var(--border2);
      border-radius: 10px
    }

    button {
      font-family: inherit
    }

    code {
      background: var(--bg);
      padding: 1px 5px;
      border-radius: 3px;
      font-size: 12px;
      font-family: var(--f-mono)
    }

    strong {
      color: var(--txt-h)
    }

    .mono {
      font-family: var(--f-mono);
      font-variant-numeric: tabular-nums
    }

    /* Background: extremely subtle radial signal glow, sits behind everything */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      z-index: -1;
      background:
        radial-gradient(680px 460px at 14% -8%, var(--signal-d), transparent 60%),
        radial-gradient(520px 420px at 100% 108%, rgba(0, 212, 255, .05), transparent 60%);
      pointer-events: none
    }

    /* ── APP SHELL ── */
    #app {
      display: grid;
      grid-template-columns: var(--sidebar-w) 1fr;
      grid-template-rows: var(--topbar-h) 1fr;
      height: 100vh;
      height: 100dvh;
      grid-template-areas: "sidebar topbar" "sidebar main";
      transition: grid-template-columns .22s cubic-bezier(.4, 0, .2, 1)
    }

    #app.sidebar-collapsed {
      grid-template-columns: var(--sidebar-w-collapsed) 1fr
    }

    /* ── TOP BAR ── */
    header {
      grid-area: topbar;
      display: flex;
      align-items: center;
      height: var(--topbar-h);
      padding: 0 18px;
      padding-top: var(--safe-top);
      background: var(--glass);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border);
      gap: 18px;
      z-index: 20
    }

    .tb-title {
      font-family: var(--f-display);
      font-size: 14px;
      font-weight: 600;
      color: var(--txt-h);
      letter-spacing: .3px
    }

    .tb-pills {
      display: flex;
      align-items: center;
      gap: 8px;
      overflow-x: auto;
      scrollbar-width: none;
      flex: 1
    }

    .tb-pills::-webkit-scrollbar {
      display: none
    }

    .tb-pill {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      font-weight: 500;
      color: var(--txt-m);
      padding: 5px 11px;
      border-radius: 20px;
      border: 1px solid var(--border);
      background: rgba(255, 255, 255, .02);
      white-space: nowrap;
      flex-shrink: 0;
      transition: border-color .3s, color .3s
    }

    .tb-pill .dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--txt-dim);
      transition: background .3s, box-shadow .3s;
      flex-shrink: 0
    }

    .tb-pill.ok .dot {
      background: var(--green);
      box-shadow: 0 0 6px var(--green)
    }

    .tb-pill.warn .dot {
      background: var(--amber);
      box-shadow: 0 0 6px var(--amber)
    }

    .tb-pill.bad .dot {
      background: var(--red);
      box-shadow: 0 0 6px var(--red)
    }

    .tb-pill.live .dot {
      background: var(--cyan);
      box-shadow: 0 0 6px var(--cyan);
      animation: pulse-dot 1.6s ease-in-out infinite
    }

    @keyframes pulse-dot {

      0%,
      100% {
        opacity: 1
      }

      50% {
        opacity: .4
      }
    }

    .tb-btns {
      display: flex;
      gap: 6px;
      flex-shrink: 0
    }

    .hdr-btn {
      width: 32px;
      height: 32px;
      border-radius: 9px;
      border: 1px solid var(--border);
      background: transparent;
      color: var(--txt-m);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all .2s
    }

    .hdr-btn:hover {
      border-color: var(--border2);
      color: var(--txt-h);
      background: var(--bg3)
    }

    .hdr-btn.active {
      border-color: var(--signal);
      color: var(--signal);
      background: var(--signal-d)
    }

    .hdr-btn svg {
      width: 16px;
      height: 16px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round
    }

    /* ── SIDEBAR ── */
    .sidebar {
      grid-area: sidebar;
      background: var(--bg2);
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      z-index: 30
    }

    .sb-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      height: var(--topbar-h);
      padding: 0 16px;
      padding-top: var(--safe-top);
      flex-shrink: 0;
      border-bottom: 1px solid var(--border)
    }

    .sb-mark {
      width: 26px;
      height: 26px;
      border-radius: 8px;
      background: linear-gradient(135deg, var(--signal), #4a3bff);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      box-shadow: 0 0 16px var(--signal-glow)
    }

    .sb-mark svg {
      width: 14px;
      height: 14px;
      stroke: #fff;
      fill: none;
      stroke-width: 2.4;
      stroke-linecap: round;
      stroke-linejoin: round
    }

    .sb-wordmark {
      font-family: var(--f-display);
      font-weight: 700;
      font-size: 15px;
      letter-spacing: 2.5px;
      color: var(--txt-h);
      white-space: nowrap;
      overflow: hidden;
      transition: opacity .15s
    }

    #app.sidebar-collapsed .sb-wordmark {
      opacity: 0;
      width: 0
    }

    .sb-nav {
      flex: 1;
      overflow-y: auto;
      padding: 10px 8px;
      display: flex;
      flex-direction: column;
      gap: 2px
    }

    .sb-item {
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 9px 10px;
      border-radius: var(--r-sm);
      color: var(--txt-m);
      cursor: pointer;
      border: 1px solid transparent;
      transition: all .16s;
      white-space: nowrap;
      overflow: hidden;
      position: relative
    }

    .sb-item:hover {
      background: var(--bg3);
      color: var(--txt-h)
    }

    .sb-item.active {
      background: var(--signal-d);
      color: var(--signal);
      border-color: rgba(124, 108, 255, .25)
    }

    .sb-item.active::before {
      content: '';
      position: absolute;
      left: -8px;
      top: 50%;
      transform: translateY(-50%);
      width: 3px;
      height: 16px;
      border-radius: 2px;
      background: var(--signal)
    }

    .sb-item svg {
      width: 17px;
      height: 17px;
      stroke: currentColor;
      fill: none;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
      flex-shrink: 0
    }

    .sb-item span {
      font-size: 13px;
      font-weight: 500;
      transition: opacity .1s
    }

    #app.sidebar-collapsed .sb-item span {
      opacity: 0;
      width: 0
    }

    #app.sidebar-collapsed .sb-item {
      justify-content: center
    }

    #app.sidebar-collapsed .sb-item.active::before {
      display: none
    }

    .sb-foot {
      padding: 12px;
      border-top: 1px solid var(--border);
      flex-shrink: 0
    }

    .sb-collapse-btn {
      width: 100%;
      height: 32px;
      border-radius: var(--r-sm);
      border: 1px solid var(--border);
      background: transparent;
      color: var(--txt-m);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all .2s
    }

    .sb-collapse-btn:hover {
      color: var(--txt-h);
      border-color: var(--border2)
    }

    .sb-collapse-btn svg {
      width: 15px;
      height: 15px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
      transition: transform .2s
    }

    #app.sidebar-collapsed .sb-collapse-btn svg {
      transform: rotate(180deg)
    }

    /* ── MAIN AREA ── */
    main {
      grid-area: main;
      display: grid;
      grid-template-columns: 1fr var(--right-w);
      overflow: hidden;
      transition: grid-template-columns .2s;
      background: radial-gradient(ellipse at 50% 46%, #0e0e1c, #08080f 68%)
    }

    main.right-collapsed {
      grid-template-columns: 1fr 0px
    }

    #main-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      pointer-events: none
    }

    main.canvas-active #main-canvas {
      pointer-events: auto
    }

    #pages-wrap {
      position: relative;
      z-index: 1
    }

    .mode-switcher {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 10px
    }

    .mode-chip {
      padding: 6px 10px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: transparent;
      color: var(--txt-m);
      font-size: 11px;
      cursor: pointer
    }

    .mode-chip.on {
      border-color: var(--signal);
      color: var(--signal);
      background: var(--signal-d)
    }

    .page {
      display: none;
      overflow-y: auto;
      padding: 26px 28px
    }

    .page.active {
      display: block
    }

    .page-head {
      margin-bottom: 22px
    }

    .page-eyebrow {
      font-family: var(--f-mono);
      font-size: 10px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--signal);
      margin-bottom: 5px
    }

    .page-title {
      font-family: var(--f-display);
      font-size: 22px;
      font-weight: 600;
      color: var(--txt-h)
    }

    .page-sub {
      font-size: 13px;
      color: var(--txt-m);
      margin-top: 4px;
      max-width: 60ch
    }

    /* Card primitives, reused across pages */
    .card {
      background: var(--glass);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid var(--border);
      border-radius: var(--r-lg);
      padding: 16px 18px
    }

    .card-title {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.4px;
      color: var(--txt-m);
      margin-bottom: 12px
    }

    .grid-cards {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
      gap: 12px
    }

    .stat-card {
      display: flex;
      flex-direction: column;
      gap: 6px
    }

    .stat-card .stat-label {
      font-size: 11px;
      color: var(--txt-m);
      display: flex;
      align-items: center;
      justify-content: space-between
    }

    .stat-card .stat-val {
      font-family: var(--f-mono);
      font-size: 22px;
      font-weight: 500;
      color: var(--txt-h)
    }

    .stat-card .stat-val small {
      font-size: 12px;
      color: var(--txt-m);
      font-weight: 400;
      margin-left: 4px
    }

    .pill-sm {
      font-size: 9px;
      padding: 2px 7px;
      border-radius: 10px;
      background: var(--green-d);
      color: var(--green);
      font-weight: 600;
      letter-spacing: .3px
    }

    .pill-sm.warn {
      background: var(--amber-d);
      color: var(--amber)
    }

    .pill-sm.off {
      background: rgba(255, 255, 255, .05);
      color: var(--txt-m)
    }

    /* ── CENTER: CHAT PAGE (orb + log) ── */
    #page-chats {
      display: none;
      grid-template-columns: 1fr;
      padding: 0;
      overflow: hidden
    }

    #page-chats.active {
      display: grid
    }

    .chat-layout {
      display: grid;
      grid-template-rows: 1fr auto;
      height: 100%;
      overflow: hidden
    }

    .orb-zone {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 22px;
      padding: 20px;
      overflow: hidden;
      border-bottom: 1px solid var(--border)
    }

    .orb-wrap {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center
    }

    .orb {
      width: var(--orb-size);
      height: var(--orb-size);
      border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, var(--bg3), var(--bg2));
      border: 2px solid var(--signal);
      box-shadow: 0 0 40px var(--signal-glow), 0 0 90px rgba(124, 108, 255, .1);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      transition: border-color .4s, box-shadow .4s, background .4s
    }

    .orb-ring {
      position: absolute;
      inset: -13px;
      border-radius: 50%;
      border: 1px solid transparent;
      transition: border-color .4s, opacity .4s
    }

    .orb-ring-2 {
      position: absolute;
      inset: -26px;
      border-radius: 50%;
      border: 1px dashed transparent;
      transition: border-color .4s, opacity .4s
    }

    .orb-inner {
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      transition: color .3s;
      font-family: var(--f-display)
    }

    .orb[data-state="INITIALIZING"] {
      border-color: var(--border2);
      box-shadow: none;
      animation: orb-idle 4s ease-in-out infinite
    }

    .orb[data-state="INITIALIZING"] .orb-inner {
      color: var(--txt-m)
    }

    .orb[data-state="INITIALIZING"] .orb-ring-2 {
      border-color: var(--border2);
      animation: spin-slow 8s linear infinite;
      opacity: .4
    }

    .orb[data-state="LISTENING"] {
      border-color: var(--cyan);
      box-shadow: 0 0 40px rgba(0, 212, 255, .18), 0 0 90px rgba(0, 212, 255, .06);
      animation: orb-listen 3s ease-in-out infinite
    }

    .orb[data-state="LISTENING"] .orb-inner {
      color: var(--cyan)
    }

    .orb[data-state="LISTENING"] .orb-ring {
      border-color: rgba(0, 212, 255, .32)
    }

    .orb[data-state="SPEAKING"] {
      border-color: var(--amber);
      box-shadow: 0 0 54px rgba(255, 170, 0, .22), 0 0 110px rgba(255, 170, 0, .08);
      animation: orb-speak 1.5s ease-in-out infinite
    }

    .orb[data-state="SPEAKING"] .orb-inner {
      color: var(--amber)
    }

    .orb[data-state="SPEAKING"] .orb-ring {
      border-color: rgba(255, 170, 0, .32)
    }

    .orb[data-state="THINKING"] {
      border-color: var(--amber);
      box-shadow: 0 0 32px rgba(255, 170, 0, .12);
      animation: orb-think 2s ease-in-out infinite
    }

    .orb[data-state="THINKING"] .orb-inner {
      color: var(--amber)
    }

    .orb[data-state="THINKING"] .orb-ring-2 {
      border-color: rgba(255, 170, 0, .25);
      animation: spin-slow 3s linear infinite;
      opacity: .6
    }

    .orb[data-state="MUTED"] {
      border-color: var(--red);
      box-shadow: none;
      opacity: .6
    }

    .orb[data-state="MUTED"] .orb-inner {
      color: var(--red)
    }

    .orb[data-state="IDLE"] {
      border-color: var(--signal);
      box-shadow: 0 0 30px var(--signal-glow)
    }

    .orb[data-state="IDLE"] .orb-inner {
      color: var(--signal)
    }

    .orb[data-state="DISCONNECTED"] {
      border-color: var(--red);
      animation: orb-disconnected 2s ease-in-out infinite;
      opacity: .5
    }

    .orb[data-state="DISCONNECTED"] .orb-inner {
      color: var(--red)
    }

    @keyframes orb-idle {

      0%,
      100% {
        transform: scale(1);
        opacity: .7
      }

      50% {
        transform: scale(1.02);
        opacity: .9
      }
    }

    @keyframes orb-listen {

      0%,
      100% {
        transform: scale(1);
        box-shadow: 0 0 40px rgba(0, 212, 255, .15), 0 0 80px rgba(0, 212, 255, .05)
      }

      50% {
        transform: scale(1.04);
        box-shadow: 0 0 60px rgba(0, 212, 255, .25), 0 0 120px rgba(0, 212, 255, .1)
      }
    }

    @keyframes orb-speak {

      0%,
      100% {
        transform: scale(1)
      }

      50% {
        transform: scale(1.06)
      }
    }

    @keyframes orb-think {

      0%,
      100% {
        transform: scale(1);
        opacity: .9
      }

      50% {
        transform: scale(1.03);
        opacity: 1
      }
    }

    @keyframes orb-disconnected {

      0%,
      100% {
        opacity: .4
      }

      50% {
        opacity: .6
      }
    }

    @keyframes spin-slow {
      to {
        transform: rotate(360deg)
      }
    }

    .state-label {
      font-family: var(--f-display);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      transition: color .3s
    }

    .waveform {
      display: flex;
      align-items: center;
      gap: 2px;
      height: 36px
    }

    .waveform .bar {
      width: 3px;
      background: var(--cyan);
      border-radius: 2px;
      transition: height .1s ease, height .3s ease, background .3s, opacity .3s;
      opacity: .3
    }

    .waveform.active .bar {
      opacity: 1;
      animation: wave-bar var(--d, .5s) ease-in-out infinite alternate
    }

    .waveform.active.speaking .bar {
      background: var(--amber)
    }

    .waveform.active.thinking .bar {
      background: var(--amber);
      opacity: .5;
      animation: none;
      height: 3px !important
    }

    @keyframes wave-bar {
      from {
        height: var(--h-min, 4px)
      }

      to {
        height: var(--h-max, 20px)
      }
    }

    .chat-bottom {
      display: flex;
      flex-direction: column;
      flex-shrink: 0
    }

    #activity-log-inline {
      max-height: 220px;
      overflow-y: auto;
      padding: 10px 20px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      scroll-behavior: smooth;
      border-bottom: 1px solid var(--border)
    }

    .log-msg {
      font-size: 13px;
      line-height: 1.55;
      max-width: 100%;
      word-wrap: break-word;
      animation: log-in .25s ease
    }

    @keyframes log-in {
      from {
        opacity: 0;
        transform: translateY(6px)
      }

      to {
        opacity: 1;
        transform: translateY(0)
      }
    }

    .log-msg.user {
      padding: 6px 10px;
      border-radius: 8px;
      background: var(--bg3);
      border: 1px solid var(--border);
      color: var(--txt-h);
      max-width: 80%;
      align-self: flex-end
    }

    .log-msg.user .log-prefix {
      color: var(--txt-m);
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: .5px;
      display: block;
      margin-bottom: 2px
    }

    .log-msg.vyren {
      padding: 6px 10px;
      border-radius: 8px;
      color: var(--txt);
      border-left: 2px solid var(--signal);
      max-width: 80%
    }

    .log-msg.vyren .log-prefix {
      color: var(--signal);
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: .5px;
      display: block;
      margin-bottom: 2px
    }

    .log-msg.system {
      font-size: 11px;
      color: var(--txt-m);
      text-align: center;
      padding: 4px 8px;
      font-family: var(--f-mono)
    }

    .log-msg.tool {
      font-size: 11px;
      color: var(--amber);
      text-align: center;
      padding: 5px 12px;
      background: var(--amber-d);
      border-radius: 16px;
      align-self: center;
      font-family: var(--f-mono);
      display: flex;
      align-items: center;
      gap: 6px
    }

    .log-msg.tool::before {
      content: '⚙';
      font-size: 10px
    }

    .log-msg.confirm {
      padding: 12px 14px;
      background: var(--red-d);
      border: 1px solid rgba(255, 68, 102, .2);
      border-radius: var(--r);
      text-align: center
    }

    .confirm-actions {
      display: flex;
      gap: 8px;
      margin-top: 8px;
      justify-content: center
    }

    .confirm-actions button {
      padding: 6px 16px;
      border: none;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      font-family: inherit
    }

    .btn-approve {
      background: var(--green);
      color: #000
    }

    .btn-decline {
      background: var(--bg);
      color: var(--txt);
      border: 1px solid var(--border2) !important
    }

    .typing-dots {
      display: inline-flex;
      gap: 4px;
      padding: 6px 10px
    }

    .typing-dots span {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--signal);
      animation: dot-bounce .6s ease-in-out infinite
    }

    .typing-dots span:nth-child(2) {
      animation-delay: .15s
    }

    .typing-dots span:nth-child(3) {
      animation-delay: .3s
    }

    @keyframes dot-bounce {

      0%,
      100% {
        transform: translateY(0);
        opacity: .3
      }

      50% {
        transform: translateY(-4px);
        opacity: 1
      }
    }

    .input-bar {
      display: flex;
      gap: 8px;
      padding: 12px 20px;
      padding-bottom: max(12px, var(--safe-bot));
      align-items: center
    }

    #msg-input {
      flex: 1;
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: 11px;
      padding: 10px 15px;
      color: var(--txt-h);
      font-size: 13px;
      font-family: inherit;
      outline: none;
      transition: border-color .2s, box-shadow .2s
    }

    #msg-input:focus {
      border-color: var(--signal);
      box-shadow: 0 0 0 3px var(--signal-d)
    }

    #msg-input::placeholder {
      color: var(--txt-m)
    }

    .send-btn {
      width: 38px;
      height: 38px;
      border-radius: 11px;
      background: var(--signal);
      border: none;
      color: #fff;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: transform .15s, opacity .15s
    }

    .send-btn:active {
      transform: scale(.92)
    }

    .send-btn:disabled {
      opacity: .25;
      pointer-events: none
    }

    .send-btn svg {
      width: 16px;
      height: 16px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2.5;
      stroke-linecap: round;
      stroke-linejoin: round
    }

    .attach-btn {
      width: 38px;
      height: 38px;
      border-radius: 11px;
      background: transparent;
      border: 1px solid var(--border);
      color: var(--txt-m);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: all .15s
    }

    .attach-btn:hover {
      color: var(--txt-h);
      border-color: var(--border2)
    }

    .attach-btn svg {
      width: 16px;
      height: 16px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round
    }

    /* ── RIGHT PANEL: WORKSPACE ── */
    .right-panel {
      background: var(--glass);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border-left: 1px solid var(--border);
      overflow-y: auto;
      overflow-x: hidden;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      transition: opacity .15s, padding .2s
    }

    main.right-collapsed .right-panel {
      opacity: 0;
      padding: 16px 0;
      pointer-events: none
    }

    .rp-section-title {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.4px;
      color: var(--txt-m);
      display: flex;
      align-items: center;
      justify-content: space-between
    }

    .rp-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-top: 8px
    }

    .rp-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 8px 10px;
      border-radius: var(--r-sm);
      background: rgba(255, 255, 255, .02);
      border: 1px solid var(--border);
      font-size: 12px
    }

    .rp-item .rp-name {
      color: var(--txt-h);
      font-weight: 500;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap
    }

    .rp-item .rp-meta {
      color: var(--txt-m);
      font-size: 10px;
      font-family: var(--f-mono);
      flex-shrink: 0
    }

    .rp-empty {
      font-size: 12px;
      color: var(--txt-m);
      text-align: center;
      padding: 10px 4px
    }

    .mon-row {
      display: flex;
      flex-direction: column;
      gap: 5px
    }

    .mon-label {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-size: 12px;
      color: var(--txt-m)
    }

    .mon-val {
      font-weight: 600;
      color: var(--txt-h);
      font-variant-numeric: tabular-nums;
      font-size: 12px;
      font-family: var(--f-mono)
    }

    .mon-bar {
      height: 4px;
      background: var(--bg);
      border-radius: 2px;
      overflow: hidden
    }

    .mon-fill {
      height: 100%;
      border-radius: 2px;
      transition: width .8s ease, background .5s
    }

    .drop-zone-wrap {
      padding: 0
    }

    .drop-zone {
      border: 1px dashed var(--border);
      border-radius: var(--r);
      padding: 14px;
      text-align: center;
      font-size: 12px;
      color: var(--txt-m);
      cursor: pointer;
      transition: all .2s
    }

    .drop-zone:hover,
    .drop-zone.drag-over {
      border-color: var(--signal);
      color: var(--signal);
      background: var(--signal-d)
    }

    .drop-zone .dz-icon {
      font-size: 18px;
      margin-bottom: 4px;
      display: block;
      opacity: .5
    }

    .drop-zone input {
      display: none
    }

    /* ── RECONNECTING BAR ── */
    .reconnecting {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      z-index: 100;
      background: linear-gradient(90deg, transparent, var(--amber), transparent);
      animation: reconnect-slide 1.5s ease-in-out infinite
    }

    @keyframes reconnect-slide {
      0% {
        transform: translateX(-100%)
      }

      100% {
        transform: translateX(100%)
      }
    }

    /* ── GENERIC PAGE COMPONENTS (Memory / Logs / Settings / Dashboard / Files / Planner / Developer / Vision / Browser) ── */
    .mem-tier {
      margin-bottom: 18px
    }

    .mem-tier-label {
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: var(--f-display);
      font-size: 13px;
      font-weight: 600;
      color: var(--txt-h);
      margin-bottom: 10px
    }

    .mem-tier-label .cnt {
      font-family: var(--f-mono);
      font-size: 11px;
      color: var(--txt-m);
      font-weight: 400
    }

    .mem-chip-list {
      display: flex;
      flex-direction: column;
      gap: 6px
    }

    .mem-chip {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 9px 12px;
      background: var(--glass);
      border: 1px solid var(--border);
      border-radius: var(--r-sm);
      font-size: 12.5px;
      color: var(--txt)
    }

    .mem-chip .dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--signal);
      flex-shrink: 0
    }

    .mem-search {
      display: flex;
      gap: 8px;
      margin-bottom: 18px
    }

    .mem-search input {
      flex: 1;
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: var(--r-sm);
      padding: 9px 13px;
      color: var(--txt-h);
      font-size: 13px;
      outline: none
    }

    .mem-search input:focus {
      border-color: var(--signal)
    }

    .log-stream {
      display: flex;
      flex-direction: column
    }

    .log-line {
      display: flex;
      gap: 14px;
      padding: 9px 4px;
      border-bottom: 1px solid var(--border);
      font-size: 12.5px;
      align-items: baseline
    }

    .log-line .lt {
      font-family: var(--f-mono);
      color: var(--txt-dim);
      font-size: 11px;
      flex-shrink: 0;
      width: 52px
    }

    .log-line .lm {
      color: var(--txt)
    }

    .log-line .lm.hl {
      color: var(--signal)
    }

    .settings-section {
      margin-bottom: 26px
    }

    .settings-section-title {
      font-family: var(--f-display);
      font-size: 14px;
      font-weight: 600;
      color: var(--txt-h);
      margin-bottom: 2px
    }

    .settings-section-sub {
      font-size: 12px;
      color: var(--txt-m);
      margin-bottom: 12px
    }

    .settings-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 0;
      border-bottom: 1px solid var(--border);
      gap: 16px
    }

    .settings-row:last-child {
      border-bottom: none
    }

    .settings-row-label {
      font-size: 13px;
      color: var(--txt-h);
      font-weight: 500
    }

    .settings-row-desc {
      font-size: 11.5px;
      color: var(--txt-m);
      margin-top: 2px
    }

    .toggle {
      width: 38px;
      height: 22px;
      border-radius: 12px;
      background: var(--bg3);
      border: 1px solid var(--border);
      position: relative;
      cursor: pointer;
      flex-shrink: 0;
      transition: background .2s
    }

    .toggle::after {
      content: '';
      position: absolute;
      top: 2px;
      left: 2px;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: var(--txt-m);
      transition: transform .2s, background .2s
    }

    .toggle.on {
      background: var(--signal-d);
      border-color: var(--signal)
    }

    .toggle.on::after {
      transform: translateX(16px);
      background: var(--signal)
    }

    .sel {
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: var(--r-sm);
      padding: 7px 10px;
      color: var(--txt-h);
      font-size: 12.5px;
      font-family: inherit;
      outline: none;
      min-width: 150px
    }

    .fm-toolbar {
      display: flex;
      gap: 10px;
      margin-bottom: 16px
    }

    .fm-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 12px
    }

    .fm-card {
      background: var(--glass);
      border: 1px solid var(--border);
      border-radius: var(--r);
      padding: 14px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      transition: border-color .15s
    }

    .fm-card:hover {
      border-color: var(--border2)
    }

    .fm-icon {
      width: 34px;
      height: 34px;
      border-radius: 9px;
      background: var(--signal-d);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--signal);
      font-size: 15px;
      font-weight: 600;
      font-family: var(--f-mono)
    }

    .fm-name {
      font-size: 12.5px;
      color: var(--txt-h);
      font-weight: 500;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap
    }

    .fm-meta {
      font-size: 10.5px;
      color: var(--txt-m);
      font-family: var(--f-mono)
    }

    .fm-actions {
      display: flex;
      gap: 5px;
      margin-top: 2px
    }

    .fm-actions button {
      flex: 1;
      font-size: 10.5px;
      padding: 5px 0;
      border-radius: 6px;
      border: 1px solid var(--border);
      background: transparent;
      color: var(--txt-m);
      cursor: pointer;
      transition: all .15s
    }

    .fm-actions button:hover {
      color: var(--txt-h);
      border-color: var(--border2)
    }

    .plan-col {
      display: flex;
      flex-direction: column;
      gap: 8px
    }

    .plan-task {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 10px 12px;
      background: var(--glass);
      border: 1px solid var(--border);
      border-radius: var(--r-sm)
    }

    .plan-task .chk {
      width: 15px;
      height: 15px;
      border-radius: 5px;
      border: 1.5px solid var(--border2);
      flex-shrink: 0;
      margin-top: 2px
    }

    .plan-task.done .chk {
      background: var(--green);
      border-color: var(--green)
    }

    .plan-task.done .plan-task-title {
      color: var(--txt-m);
      text-decoration: line-through
    }

    .plan-task-title {
      font-size: 12.5px;
      color: var(--txt-h)
    }

    .plan-task-meta {
      font-size: 10.5px;
      color: var(--txt-m);
      margin-top: 3px;
      font-family: var(--f-mono)
    }

    .dev-block {
      margin-bottom: 16px
    }

    .dev-label {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      color: var(--txt-m);
      margin-bottom: 8px
    }

    .dev-code {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--r-sm);
      padding: 12px 14px;
      font-family: var(--f-mono);
      font-size: 11.5px;
      color: var(--txt);
      line-height: 1.7;
      overflow-x: auto;
      white-space: pre-wrap
    }

    .dev-code .k {
      color: var(--signal)
    }

    .dev-code .v {
      color: var(--green)
    }

    .dev-code .err {
      color: var(--red)
    }

    .empty-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 60px 20px;
      text-align: center
    }

    .empty-state .es-icon {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      background: var(--bg3);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--txt-dim)
    }

    .empty-state .es-icon svg {
      width: 24px;
      height: 24px;
      stroke: currentColor;
      fill: none;
      stroke-width: 1.6
    }

    .empty-state .es-title {
      font-family: var(--f-display);
      font-size: 14px;
      font-weight: 600;
      color: var(--txt-h)
    }

    .empty-state .es-sub {
      font-size: 12px;
      color: var(--txt-m);
      max-width: 32ch
    }

    /* ── MOBILE (<768px) ── */
    @media(max-width:767px) {
      #app {
        grid-template-columns: 0 1fr;
        padding-bottom: env(safe-area-inset-bottom, 0px)
      }

      #app.sidebar-open {
        grid-template-columns: var(--sidebar-w) 1fr
      }

      .sidebar {
        position: fixed;
        top: 0;
        left: 0;
        bottom: 0;
        width: var(--sidebar-w);
        transform: translateX(-100%);
        transition: transform .22s;
        z-index: 50
      }

      #app.sidebar-open .sidebar {
        transform: translateX(0)
      }

      header {
        padding-left: 12px;
        padding-right: 12px;
        gap: 10px
      }

      .tb-pills {
        gap: 6px
      }

      main {
        grid-template-columns: 1fr;
        padding-bottom: 84px
      }

      .right-panel {
        position: fixed;
        top: var(--topbar-h);
        right: 0;
        bottom: 0;
        width: 86vw;
        max-width: 340px;
        transform: translateX(100%);
        transition: transform .22s;
        z-index: 40
      }

      main.right-open .right-panel {
        transform: translateX(0)
      }

      .orb {
        --orb-size: 120px
      }

      .page {
        padding: 16px 14px
      }

      #page-immersive {
        display: none;
        position: fixed;
        inset: 0;
        background: #05050a;
        z-index: 50;
        overflow: hidden
      }

      #page-immersive.active {
        display: block
      }

      #immersive-canvas {
        width: 100vw;
        height: 100vh;
        display: block
      }

      .immersive-hud {
        position: absolute;
        left: 14px;
        top: 14px;
        color: #8a8a9a;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
        font-size: 11px;
        pointer-events: none;
        letter-spacing: .08em;
        text-shadow: 0 1px 6px rgba(0,0,0,.7);
        z-index: 2
      }

      .immersive-hud b {
        color: #c8c8d8
      }

      .immersive-state {
        margin-top: 6px;
        font-weight: 600;
        text-transform: uppercase
      }

      .immersive-error {
        position: absolute;
        left: 14px;
        bottom: 14px;
        color: #ff7799;
        font-family: ui-monospace, Menlo, monospace;
        font-size: 11px;
        z-index: 2;
        display: none
      }

      .bottom-nav {
        display: flex
      }

      .input-bar {
        padding-bottom: max(12px, env(safe-area-inset-bottom, 0px))
      }
    }

    @media(min-width:768px) {
      .bottom-nav {
        display: none
      }
    }

    /* ── BOTTOM NAV ── */
    .bottom-nav {
      display: none;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 45;
      background: rgba(13, 13, 22, .92);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-top: 1px solid var(--border);
      padding: 6px 8px;
      padding-bottom: max(8px, env(safe-area-inset-bottom, 0px));
      gap: 4px
    }

    .bnav-item {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
      padding: 8px 4px;
      border-radius: 10px;
      color: var(--txt-m);
      background: transparent;
      border: 1px solid transparent;
      cursor: pointer;
      font-family: var(--f-body);
      font-size: 10px;
      font-weight: 500
    }

    .bnav-item.active {
      color: var(--signal);
      background: var(--signal-d);
      border-color: rgba(124, 108, 255, .22)
    }

    .bnav-item svg {
      width: 20px;
      height: 20px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round
    }

    /* ── CHAT / VOICE ── */
    .voice-row {
      display: flex;
      gap: 10px;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap
    }

    .mic-btn {
      width: 52px;
      height: 52px;
      border-radius: 999px;
      border: 1px solid var(--border2);
      background: radial-gradient(circle at 35% 30%, var(--bg3), var(--bg2));
      color: var(--txt-h);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform .15s, border-color .2s, color .2s
    }

    .mic-btn:active {
      transform: scale(.97)
    }

    .mic-btn.listening {
      border-color: var(--cyan);
      color: var(--cyan);
      box-shadow: 0 0 24px rgba(0, 212, 255, .18)
    }

    .mic-btn.speaking {
      border-color: var(--amber);
      color: var(--amber);
      box-shadow: 0 0 24px rgba(255, 170, 0, .18)
    }

    .mic-btn svg {
      width: 22px;
      height: 22px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round
    }

    .quick-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      justify-content: center;
      margin-top: 10px
    }

    .qbtn {
      padding: 9px 13px;
      border-radius: 999px;
      border: 1px solid var(--border2);
      background: transparent;
      color: var(--txt-h);
      cursor: pointer;
      font-family: var(--f-body);
      font-size: 12px
    }

    .qbtn:active {
      background: var(--bg3)
    }

    .panel-card {
      background: var(--glass);
      border: 1px solid var(--border);
      border-radius: var(--r-lg);
      padding: 14px 16px;
      margin-bottom: 12px
    }

    .panel-card .panel-title {
      font-family: var(--f-display);
      font-size: 14px;
      color: var(--txt-h);
      margin-bottom: 8px
    }

    .two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px
    }

    .status-pill {
      font-size: 11px;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 999px;
      border: 1px solid var(--border);
      color: var(--txt-m);
      background: rgba(255, 255, 255, .02)
    }

    .status-pill.on {
      border-color: rgba(0, 255, 136, .35);
      color: var(--green);
      background: rgba(0, 255, 136, .08)
    }

    .suggested-chips {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 10px
    }

    .chip {
      padding: 8px 12px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: transparent;
      color: var(--txt-h);
      cursor: pointer;
      font-size: 12px
    }

    .chip:active {
      background: var(--bg3)
    }
  </style>
</head>

<body>
  <div id="app">

    <!-- SIDEBAR -->
    <nav class="sidebar" id="sidebar">
      <div class="sb-brand">
        <div class="sb-mark"><svg viewBox="0 0 24 24">
            <path d="M13 2 3 14h8l-1 8 10-12h-8l1-8z" />
          </svg></div>
        <div class="sb-wordmark">VYREN</div>
      </div>
      <div class="sb-nav" id="sb-nav">
        <div class="sb-item active" data-page="chats"><svg viewBox="0 0 24 24">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
          </svg><span>Chats</span></div>
        <div class="sb-item" data-page="memory"><svg viewBox="0 0 24 24">
            <path d="M12 2a7 7 0 0 0-7 7c0 3 2 4 2 7v2h10v-2c0-3 2-4 2-7a7 7 0 0 0-7-7z" />
            <line x1="9" y1="21" x2="15" y2="21" />
          </svg><span>Memory</span></div>
        <div class="sb-item" data-page="planner"><svg viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2" />
            <line x1="16" y1="2" x2="16" y2="6" />
            <line x1="8" y1="2" x2="8" y2="6" />
            <line x1="3" y1="10" x2="21" y2="10" />
          </svg><span>Planner</span></div>
        <div class="sb-item" data-page="files"><svg viewBox="0 0 24 24">
            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
          </svg><span>Files</span></div>
        <div class="sb-item" data-page="vision"><svg viewBox="0 0 24 24">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
            <circle cx="12" cy="12" r="3" />
          </svg><span>Vision</span></div>
        <div class="sb-item" data-page="browser"><svg viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10" />
            <line x1="2" y1="12" x2="22" y2="12" />
            <path d="M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20z" />
          </svg><span>Browser</span></div>
        <div class="sb-item" data-page="graph"><svg viewBox="0 0 24 24">
            <circle cx="5" cy="5" r="2" />
            <circle cx="19" cy="5" r="2" />
            <circle cx="12" cy="19" r="2" />
            <line x1="5" y1="5" x2="19" y2="5" />
            <line x1="12" y1="19" x2="5" y2="5" />
            <line x1="12" y1="19" x2="19" y2="5" />
          </svg><span>Graph</span></div>
        <div class="sb-item" data-page="skills"><svg viewBox="0 0 24 24">
            <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4l-6 6a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l6-6a4 4 0 0 0 5.4-5.4z" />
          </svg><span>Skills</span></div>
        <div class="sb-item" data-page="logs"><svg viewBox="0 0 24 24">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <polyline points="14 2 14 8 20 8" />
            <line x1="9" y1="13" x2="15" y2="13" />
            <line x1="9" y1="17" x2="13" y2="17" />
          </svg><span>Logs</span></div>
        <div class="sb-item" data-page="dashboard"><svg viewBox="0 0 24 24">
            <rect x="3" y="3" width="7" height="9" rx="1" />
            <rect x="14" y="3" width="7" height="5" rx="1" />
            <rect x="14" y="12" width="7" height="9" rx="1" />
            <rect x="3" y="16" width="7" height="5" rx="1" />
          </svg><span>Dashboard</span></div>
        <div class="sb-item" data-page="developer"><svg viewBox="0 0 24 24">
            <polyline points="16 18 22 12 16 6" />
            <polyline points="8 6 2 12 8 18" />
          </svg><span>Developer</span></div>
        <div class="sb-item" data-page="settings"><svg viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="3" />
            <path
              d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 .33-1.82V9a1.65 1.65 0 0 0 1.51-1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
          </svg><span>Settings</span></div>
        <div class="sb-item" data-page="system"><svg viewBox="0 0 24 24">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
            <line x1="8" y1="21" x2="16" y2="21" />
            <line x1="12" y1="17" x2="12" y2="21" />
          </svg><span>System</span></div>
      </div>
      <div class="sb-foot">
        <button class="sb-collapse-btn" id="sb-collapse-btn" title="Collapse sidebar">
          <svg viewBox="0 0 24 24">
            <polyline points="15 18 9 12 15 6" />
          </svg>
        </button>
      </div>
    </nav>

    <!-- TOP BAR -->
    <header>
      <div class="tb-title" id="page-title-tb">Chats</div>
      <div class="tb-pills" id="tb-pills">
        <div class="tb-pill live" id="pill-conn"><span class="dot"></span><span id="pill-conn-text">connecting</span>
        </div>
        <div class="tb-pill ok"><span class="dot"></span><span id="pill-model">gemini-3.1-flash-live</span></div>
        <div class="tb-pill ok"><span class="dot"></span><span id="pill-mem">memory ready</span></div>
        <div class="tb-pill off"><span class="dot"></span><span>vision idle</span></div>
        <div class="tb-pill ok"><span class="dot"></span><span id="pill-mic">mic ready</span></div>
      </div>
      <div class="tb-btns">
        <button class="hdr-btn" id="mute-btn" title="Toggle mute (M)">
          <svg viewBox="0 0 24 24">
            <path d="M12 1a4 4 0 0 0-4 4v7a4 4 0 0 0 8 0V5a4 4 0 0 0-4-4z" />
            <path d="M19 10v2a7 7 0 0 1-14 0v-2" />
            <line x1="12" y1="19" x2="12" y2="23" />
            <line x1="8" y1="23" x2="16" y2="23" />
          </svg>
        </button>
        <button class="hdr-btn" id="immersive-btn" title="Immersive mode (I)">
          <svg viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10" />
            <circle cx="12" cy="12" r="3" />
          </svg>
        </button>
        <button class="hdr-btn" id="right-toggle-btn" title="Toggle workspace panel">
          <svg viewBox="0 0 24 24">
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <line x1="15" y1="3" x2="15" y2="21" />
          </svg>
        </button>
        <button class="hdr-btn" id="fs-btn" title="Fullscreen (F11)">
          <svg viewBox="0 0 24 24">
            <polyline points="15 3 21 3 21 9" />
            <polyline points="9 21 3 21 3 15" />
            <line x1="21" y1="3" x2="14" y2="10" />
            <line x1="3" y1="21" x2="10" y2="14" />
          </svg>
        </button>
      </div>
    </header>

    <!-- MAIN -->
    <main id="main">
      <!-- Persistent 3D environment canvas behind all pages. -->
      <canvas id="main-canvas" style="position:absolute;inset:0;width:100%;height:100%;z-index:0;pointer-events:none"></canvas>
      <div id="pages-wrap" style="position:relative;z-index:1;overflow:hidden;display:flex;flex-direction:column;min-width:0">

        <!-- CHATS (live, unchanged behavior) -->
        <div class="page active" id="page-chats">
          <div class="chat-layout">
            <div class="orb-zone">
              <div class="orb-wrap">
                <div class="orb" id="orb" data-state="INITIALIZING">
                  <div class="orb-ring"></div>
                  <div class="orb-ring-2"></div>
                  <div class="orb-inner" id="orb-label">...</div>
                </div>
              </div>
              <div class="state-label" id="state-label">Initializing</div>
              <div class="waveform" id="waveform"></div>
              <div class="mode-switcher" id="mode-switcher">
                <button class="mode-chip on" data-mode="orb">Orb</button>
                <button class="mode-chip" data-mode="memory">Memory</button>
                <button class="mode-chip" data-mode="system">System</button>
                <button class="mode-chip" data-mode="vision">Vision</button>
                <button class="mode-chip" data-mode="activity">Activity</button>
              </div>
              <div style="display:flex;gap:10px;margin-top:12px;flex-wrap:wrap">
                <button id="interrupt-btn" style="padding:10px 14px;border-radius:8px;border:1px solid var(--amber);background:transparent;color:var(--amber);cursor:pointer">Interrupt</button>
                <input id="self-improve-input" placeholder="Ask VYREN anything..." style="flex:1;min-width:180px;background:var(--bg-input);border:1px solid var(--border);border-radius:8px;padding:10px 12px;color:var(--txt-h);outline:none">
                <button id="self-improve-btn" style="padding:10px 14px;border-radius:8px;border:1px solid var(--signal);background:transparent;color:var(--signal);cursor:pointer">Run</button>
              </div>
              <div class="voice-row">
                <button class="mic-btn" data-mic="true" title="Tap to talk">
                  <svg viewBox="0 0 24 24">
                    <path d="M12 1a4 4 0 0 0-4 4v7a4 4 0 0 0 8 0V5a4 4 0 0 0-4-4z" />
                    <path d="M19 10v2a7 7 0 0 1-14 0v-2" />
                    <line x1="12" y1="19" x2="12" y2="23" />
                    <line x1="8" y1="23" x2="16" y2="23" />
                  </svg>
                </button>
                <span class="status-pill" id="voice-status">Tap mic to talk</span>
              </div>
              <div class="suggested-chips">
                <button class="chip" data-ask="Search the web for">Web search</button>
                <button class="chip" data-ask="Send a message saying">Send message</button>
                <button class="chip" data-ask="Check my battery status">Battery</button>
                <button class="chip" data-ask="Analyze my current screen">See screen</button>
              </div>
              <pre id="self-improve-output" style="margin-top:10px;font-size:12px;color:var(--txt-m);max-height:220px;overflow:auto;white-space:pre-wrap"></pre>
            </div>
            <div class="chat-bottom">
              <div id="activity-log-inline">
                <div class="log-msg system">VYREN ready. Type, use a quick action, or tap the mic.</div>
              </div>
              <div class="input-bar">
                <button class="attach-btn" id="attach-btn" title="Attach a file">
                  <svg viewBox="0 0 24 24">
                    <path d="M21.4 11.1 12.5 20a5 5 0 0 1-7-7l9-9a3.5 3.5 0 0 1 5 5l-9 9a2 2 0 0 1-3-3l8-8" />
                  </svg>
                </button>
                <input type="text" id="msg-input" placeholder="Type a message..." autocomplete="off">
                <button class="send-btn" id="send-btn" disabled title="Send (Enter)">
                  <svg viewBox="0 0 24 24">
                    <line x1="22" y1="2" x2="11" y2="13" />
                    <polygon points="22 2 15 22 11 13 2 9 22 2" />
                  </svg>
                </button>
                <input type="file" id="file-input" style="display:none">
              </div>
            </div>
          </div>
        </div>

        <!-- MEMORY -->
        <div class="page" id="page-memory">
          <div class="page-head">
            <div class="page-eyebrow">Recall</div>
            <div class="page-title">Memory</div>
            <div class="page-sub">Everything VYREN has chosen to keep, organized by how long it lasts.</div>
          </div>
          <div class="mem-search">
            <input type="text" id="mem-search-input" placeholder="Search memory..." autocomplete="off">
            <button id="mem-search-btn" class="fm-actions" style="padding:8px 14px;border-radius:8px;border:1px solid var(--border2);background:transparent;color:var(--txt-h);cursor:pointer">Search</button>
            <button id="mem-add-btn" class="fm-actions" style="padding:8px 14px;border-radius:8px;border:1px solid var(--border);background:transparent;color:var(--txt-m);cursor:pointer">Add</button>
          </div>
          <div class="mem-tier">
            <div class="mem-tier-label">Pinned <span class="cnt" id="mem-pinned-cnt">2</span></div>
            <div class="mem-chip-list" id="mem-pinned-list"></div>
          </div>
          <div class="mem-tier">
            <div class="mem-tier-label">Long-Term <span class="cnt" id="mem-long-cnt">0</span></div>
            <div class="mem-chip-list" id="mem-long-list"></div>
          </div>
          <div class="mem-tier">
            <div class="mem-tier-label">Recent <span class="cnt" id="mem-recent-cnt">0</span></div>
            <div class="mem-chip-list" id="mem-recent-list"></div>
          </div>
          <div class="grid-cards" style="margin-top:6px">
            <div class="card stat-card">
              <div class="stat-label">Total entries</div>
              <div class="stat-val" id="mem-total">0</div>
            </div>
            <div class="card stat-card">
              <div class="stat-label">Layers active</div>
              <div class="stat-val">dynamic</div>
            </div>
            <div class="card stat-card">
              <div class="stat-label">Last update</div>
              <div class="stat-val" style="font-size:14px" id="mem-consolidation">loading...</div>
            </div>
          </div>
        </div>

        <!-- PLANNER -->
        <div class="page" id="page-planner">
          <div class="page-head">
            <div class="page-eyebrow">Planning</div>
            <div class="page-title">Planner</div>
            <div class="page-sub">Tasks VYREN is tracking on your behalf.</div>
          </div>
          <div class="grid-cards" style="grid-template-columns:1fr 1fr;align-items:start;gap:18px">
            <div>
              <div class="mem-tier-label">Active tasks</div>
              <div class="plan-col">
                <div class="plan-task">
                  <div class="chk"></div>
                  <div>
                    <div class="plan-task-title">Fix VYREN voice self-conversation loop</div>
                    <div class="plan-task-meta">In progress · updated 4m ago</div>
                  </div>
                </div>
                <div class="plan-task">
                  <div class="chk"></div>
                  <div>
                    <div class="plan-task-title">Redesign VYREN web interface</div>
                    <div class="plan-task-meta">In progress · updated just now</div>
                  </div>
                </div>
                <div class="plan-task">
                  <div class="chk"></div>
                  <div>
                    <div class="plan-task-title">Full codebase audit (30 modules)</div>
                    <div class="plan-task-meta">Queued · blocked on voice fix</div>
                  </div>
                </div>
              </div>
            </div>
            <div>
              <div class="mem-tier-label">Completed</div>
              <div class="plan-col">
                <div class="plan-task done">
                  <div class="chk"></div>
                  <div>
                    <div class="plan-task-title">Fix 1008 GoAway session crash loop</div>
                    <div class="plan-task-meta">Done</div>
                  </div>
                </div>
                <div class="plan-task done">
                  <div class="chk"></div>
                  <div>
                    <div class="plan-task-title">Merge v1/v2 memory stores</div>
                    <div class="plan-task-meta">Done</div>
                  </div>
                </div>
                <div class="plan-task done">
                  <div class="chk"></div>
                  <div>
                    <div class="plan-task-title">Fix logger namespace bug</div>
                    <div class="plan-task-meta">Done</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="mem-tier" style="margin-top:22px">
            <div class="mem-tier-label">Scheduled</div>
            <div class="rp-list">
              <div class="rp-item"><span class="rp-name">Hourly memory consolidation</span><span class="rp-meta">every
                  3600s</span></div>
              <div class="rp-item"><span class="rp-name">Health check</span><span class="rp-meta">every 600s</span>
              </div>
            </div>
          </div>
        </div>

        <!-- FILES -->
        <div class="page" id="page-files">
          <div class="page-head">
            <div class="page-eyebrow">Storage</div>
            <div class="page-title">Files</div>
            <div class="page-sub">Upload something and ask VYREN about it directly.</div>
          </div>
          <div class="fm-toolbar">
            <div class="drop-zone" id="fm-drop-zone" style="flex:1">
              <span class="dz-icon">+</span>Drop a file here or click to upload
              <input type="file" id="fm-file-input" style="display:none">
            </div>
          </div>
          <div class="mem-tier-label" style="margin-bottom:10px">Recent files</div>
          <div class="fm-grid">
            <div class="fm-card">
              <div class="fm-icon">PY</div>
              <div class="fm-name">engine.py</div>
              <div class="fm-meta">voice_engine · 41 KB</div>
              <div class="fm-actions"><button>Preview</button><button>Ask</button></div>
            </div>
            <div class="fm-card">
              <div class="fm-icon">MD</div>
              <div class="fm-name">incident_report.md</div>
              <div class="fm-meta">docs · 6 KB</div>
              <div class="fm-actions"><button>Preview</button><button>Ask</button></div>
            </div>
            <div class="fm-card">
              <div class="fm-icon">LOG</div>
              <div class="fm-name">boot_11-53.log</div>
              <div class="fm-meta">logs · 3 KB</div>
              <div class="fm-actions"><button>Preview</button><button>Ask</button></div>
            </div>
          </div>
        </div>

        <!-- VISION -->
        <div class="page" id="page-vision">
          <div class="page-head">
            <div class="page-eyebrow">Perception</div>
            <div class="page-title">Vision</div>
            <div class="page-sub">Screen and image analysis. Off by default for privacy — enable per session.</div>
          </div>
          <div class="empty-state"
            style="border:1px dashed var(--border);border-radius:var(--r-lg);background:var(--glass)">
            <div class="es-icon"><svg viewBox="0 0 24 24">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                <circle cx="12" cy="12" r="3" />
              </svg></div>
            <div class="es-title">Vision is idle</div>
            <div class="es-sub">No screen capture or continuous analysis running. Enable it below to let VYREN see what
              you see.</div>
            <button id="vision-enable-btn" style="margin-top:14px;padding:10px 14px;border-radius:8px;border:1px solid var(--border2);background:transparent;color:var(--txt-h);cursor:pointer">Enable vision</button>
            <button id="vision-capture-btn" style="margin-top:10px;padding:10px 14px;border-radius:8px;border:1px solid var(--border);background:transparent;color:var(--txt-m);cursor:pointer">Capture screen / camera</button>
            <div id="vision-status" style="margin-top:10px;font-size:12px;color:var(--txt-m)">Idle.</div>
          </div>
          <div class="settings-row" style="margin-top:18px">
            <div>
              <div class="settings-row-label">Continuous screen analysis</div>
              <div class="settings-row-desc">VYREN watches your active window and narrates changes</div>
            </div>
            <div class="toggle" data-toggle="vision-toggle"></div>
          </div>
          <div class="settings-row">
            <div>
              <div class="settings-row-label">Webcam</div>
              <div class="settings-row-desc">Not detected</div>
            </div>
            <span class="pill-sm off">unavailable</span>
          </div>
        </div>

        <!-- BROWSER -->
        <div class="page" id="page-browser">
          <div class="page-head">
            <div class="page-eyebrow">Web</div>
            <div class="page-title">Browser &amp; URLs</div>
            <div class="page-sub">Paste a URL to ingest it, inspect page content, and feed the knowledge graph.</div>
          </div>
          <div class="grid-cards" style="grid-template-columns: 1fr 1fr; gap: 14px">
            <div class="card" style="grid-column: 1 / -1">
              <div class="card-title">Ingest URL</div>
              <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
                <input type="text" id="url-input" placeholder="https://..." style="flex:1;min-width:220px;background:var(--bg-input);border:1px solid var(--border);border-radius:var(--r-sm);padding:10px 12px;color:var(--txt-h);outline:none">
                <button id="url-ingest-btn" style="padding:10px 14px;border-radius:var(--r-sm);border:1px solid var(--border2);background:transparent;color:var(--txt-h);cursor:pointer">Ingest</button>
