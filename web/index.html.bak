  <!-- Reconnecting indicator bar -->
  <div class="reconnecting" id="reconnecting-bar" style="display:none"></div>

  <script>
    // ═══════════════════════════════════════════════════════════
    // NAVIGATION + ROUTING + WORKSPACE STATE
    // ═══════════════════════════════════════════════════════════
    (function () {
      const NAV = new Map([
        ['chats', 'page-chats'],
        ['memory', 'page-memory'],
        ['planner', 'page-planner'],
        ['files', 'page-files'],
        ['vision', 'page-vision'],
        ['browser', 'page-browser'],
        ['graph', 'page-graph'],
        ['skills', 'page-skills'],
        ['logs', 'page-logs'],
        ['dashboard', 'page-dashboard'],
        ['developer', 'page-developer'],
        ['settings', 'page-settings'],
        ['system', 'page-system'],
        ['immersive', 'page-immersive'],
      ]);

      function pageIdForKey(key) {
        return NAV.get(String(key || '').toLowerCase()) || '';
      }

      function shutdownVYREN() {
        if (!confirm('Shutdown VYREN?')) return;
        window.location.reload();
      }

      async function systemAction(action) {
        try {
          const res = await fetch('/api/system/' + action, { method: 'POST' });
          const data = await res.json();
          alert(JSON.stringify(data));
        } catch (exc) {
          alert('System action failed: ' + exc.message);
        }
      }

      async function volumeAction(level) {
        try {
          const res = await fetch('/api/system/volume', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ level }),
          });
          const data = await res.json();
          alert(JSON.stringify(data));
        } catch (exc) {
          alert('Volume action failed: ' + exc.message);
        }
      }

      function setActivePage(key) {
        if (key === 'shutdown-vyren') { shutdownVYREN(); return; }
        if (key === 'shutdown-system') { systemAction('shutdown'); return; }
        if (key === 'sleep-system') { systemAction('sleep'); return; }
        if (key === 'increase-volume') { volumeAction(80); return; }

        const target = pageIdForKey(key);
        if (!target) return;

        document.querySelectorAll('.page').forEach(el => el.classList.remove('active'));
        const el = document.getElementById(target);
        if (el) el.classList.add('active');

        document.querySelectorAll('.sb-item').forEach(el => el.classList.remove('active'));
        const navItem = document.querySelector('.sb-item[data-page="' + (key || 'chats') + '"]');
        if (navItem) navItem.classList.add('active');

        const title = document.getElementById('page-title-tb');
        if (title) title.textContent = (navItem && navItem.textContent || 'Chats').trim();

        if (target === 'page-chats') {
          document.getElementById('main').classList.add('canvas-active');
          if (window.VyrenEnv && window.VyrenEnv.start) window.VyrenEnv.start();
          if (window.initImmersive) window.initImmersive();
        } else {
          document.getElementById('main').classList.remove('canvas-active');
          if (window.VyrenEnv && window.VyrenEnv.stop) window.VyrenEnv.stop();
        }

        if (window.history && window.history.replaceState) {
          window.history.replaceState({ page: key || 'chats' }, '', '#' + (key || 'chats'));
        }
      }

      document.getElementById('sb-nav').addEventListener('click', (e) => {
        const item = e.target.closest('.sb-item');
        if (!item) return;
        const page = item.getAttribute('data-page');
        if (!page) return;
        setActivePage(page);
      });

      window.addEventListener('hashchange', () => {
        const key = (location.hash || '#chats').replace('#', '') || 'chats';
        setActivePage(key);
      });

      window.addEventListener('popstate', () => {
        const key = (location.hash || '#chats').replace('#', '') || 'chats';
        setActivePage(key);
      });

      const initPage = (location.hash || '#chats').replace('#', '') || 'chats';
      setActivePage(initPage);
    })();
  </script>

  <script>
    // ── SYSTEM BUTTONS ──
    (function () {
      const $ = (id) => document.getElementById(id);
      if ($('btn-shutdown-vyren')) {
        $('btn-shutdown-vyren').addEventListener('click', () => {
          if (!confirm('Shutdown VYREN?')) return;
          window.location.reload();
        });
      }
      if ($('btn-shutdown-system')) {
        $('btn-shutdown-system').addEventListener('click', () => fetch('/api/system/shutdown', { method: 'POST' }).then(r => r.json()).then(data => alert(JSON.stringify(data))).catch(e => alert('System action failed: ' + e.message)));
      }
      if ($('btn-restart-system')) {
        $('btn-restart-system').addEventListener('click', () => fetch('/api/system/restart', { method: 'POST' }).then(r => r.json()).then(data => alert(JSON.stringify(data))).catch(e => alert('System action failed: ' + e.message)));
      }
      if ($('btn-sleep-system')) {
        $('btn-sleep-system').addEventListener('click', () => fetch('/api/system/sleep', { method: 'POST' }).then(r => r.json()).then(data => alert(JSON.stringify(data))).catch(e => alert('System action failed: ' + e.message)));
      }
      if ($('btn-volume')) {
        $('btn-volume').addEventListener('click', () => {
          const level = parseInt(($('volume-level') && $('volume-level').value) || '80', 10);
          fetch('/api/system/volume', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ level }),
          }).then(r => r.json()).then(data => alert(JSON.stringify(data))).catch(e => alert('Volume action failed: ' + e.message));
        });
      }
    })();
  </script>

  <script>
    // ── BROWSER ACTIONS ──
    (function () {
      const $ = (id) => document.getElementById(id);
      const statusEl = $('browser-status');
      const contentEl = $('browser-content');
      function setStatus(text) { if (statusEl) statusEl.textContent = text; }
      function setContent(text) { if (contentEl) contentEl.textContent = text; }
      async function browserAction(action, payload = {}) {
        try {
          setStatus('Running: ' + action);
          const res = await fetch('/api/browser/action', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action, ...payload }),
          });
          const data = await res.json();
          if (data.status === 'success') {
            setStatus('Done: ' + action);
            if (data.result && typeof data.result === 'string') setContent(data.result);
            else setContent(JSON.stringify(data.result || data, null, 2));
          } else {
            setStatus('Error: ' + (data.error || action));
            setContent(JSON.stringify(data, null, 2));
          }
        } catch (e) {
          setStatus('Request failed: ' + e.message);
        }
      }
      if ($('browser-open-btn')) {
        $('browser-open-btn').addEventListener('click', () => {
          const url = ($('url-input') && $('url-input').value.trim()) || 'https://example.com';
          browserAction('open', { url });
        });
      }
      if ($('browser-capture-btn')) {
        $('browser-capture-btn').addEventListener('click', () => browserAction('screenshot'));
      }
      if ($('browser-text-btn')) {
        $('browser-text-btn').addEventListener('click', () => browserAction('extract_text'));
      }
      if ($('browser-links-btn')) {
        $('browser-links-btn').addEventListener('click', () => browserAction('extract_links'));
      }
      if ($('browser-fill-btn')) {
        $('browser-fill-btn').addEventListener('click', () => {
          const fields = { 'input[name="q"]': 'Hello world' };
          browserAction('fill_form', { fields });
        });
      }
      if ($('browser-search-btn')) {
        $('browser-search-btn').addEventListener('click', () => {
          const query = ($('url-input') && $('url-input').value.trim()) || 'test';
          browserAction('search', { query, engine: 'google' });
        });
      }
      if ($('browser-save-screenshot-btn')) {
        $('browser-save-screenshot-btn').addEventListener('click', () => browserAction('save_screenshot'));
      }
      const urlInput = $('url-input');
      if (urlInput) {
        urlInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' && $('browser-open-btn')) $('browser-open-btn').click();
        });
      }
    })();
  </script>
    window.VyrenEnv = (() => {
      const mainCanvas = document.getElementById('main-canvas');
      let renderer = null;
      let scene = null;
      let camera = null;
      let envRunning = false;
      let animId = null;
      let currentMode = 'orb';
      let graphData = { nodes: [], edges: [] };

      function makeOrb() {
        const group = new THREE.Group();
        const coreGeo = new THREE.SphereGeometry(1, 48, 48);
        const coreMat = new THREE.MeshPhysicalMaterial({
          roughness: 0.25,
          metalness: 0.05,
          clearcoat: 0.4,
          clearcoatRoughness: 0.2,
          color: new THREE.Color('#14142a'),
          emissive: new THREE.Color('#1f1b4d'),
          emissiveIntensity: 0.4,
          transparent: true,
          opacity: 0.95
        });
        group.add(new THREE.Mesh(coreGeo, coreMat));

        const shellGeo = new THREE.SphereGeometry(1.18, 64, 64);
        const shellMat = new THREE.MeshPhysicalMaterial({
          roughness: 0.1,
          metalness: 0,
          clearcoat: 0.8,
          color: new THREE.Color('#7c6cff'),
          emissive: new THREE.Color('#7c6cff'),
          emissiveIntensity: 0.12,
          transparent: true,
          opacity: 0.12,
          side: THREE.FrontSide
        });
        group.add(new THREE.Mesh(shellGeo, shellMat));

        group.add(new THREE.Mesh(
          new THREE.SphereGeometry(1.35, 48, 48),
          new THREE.MeshBasicMaterial({ color: new THREE.Color('#7c6cff'), transparent: true, opacity: 0.08 })
        ));

        const ring = new THREE.Mesh(
          new THREE.TorusGeometry(1.55, 0.015, 24, 220),
          new THREE.MeshBasicMaterial({ color: new THREE.Color('#7c6cff'), transparent: true, opacity: 0.35 })
        );
        ring.rotation.x = Math.PI * 0.42;
        group.add(ring);

        const ring2 = new THREE.Mesh(
          new THREE.TorusGeometry(1.7, 0.01, 24, 260),
          new THREE.MeshBasicMaterial({ color: new THREE.Color('#00d4ff'), transparent: true, opacity: 0.18 })
        );
        ring2.rotation.x = -Math.PI * 0.35;
        ring2.rotation.y = Math.PI * 0.2;
        group.add(ring2);

        const pGeo = new THREE.BufferGeometry();
        const count = 140;
        const pos = new Float32Array(count * 3);
        for (let i = 0; i < count; i++) {
          const r = 1.05 + Math.random() * 0.5;
          const theta = Math.random() * Math.PI * 2;
          const phi = Math.acos(2 * Math.random() - 1);
          pos[i*3] = r * Math.sin(phi) * Math.cos(theta);
          pos[i*3+1] = r * Math.sin(phi) * Math.sin(theta);
          pos[i*3+2] = r * Math.cos(phi);
        }
        pGeo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
        group.add(new THREE.Points(pGeo, new THREE.PointsMaterial({ color: new THREE.Color('#b8aaff'), size: 0.025, transparent: true, opacity: 0.55 })));

        group.userData = { speedTarget: 0.3 };
        return group;
      }

      function makeGraph(nodes, edges) {
        const group = new THREE.Group();
        const nodeRadius = nodes && nodes.length ? Math.min(0.35, 12 / Math.max(1, nodes.length)) : 0.22;
        const R = 2.6;
        const edgeMat = new THREE.LineBasicMaterial({ color: new THREE.Color('#ffffff'), transparent: true, opacity: 0.18 });
        const drawn = new Set();
        if (Array.isArray(edges)) {
          for (const e of edges.slice(0, 250)) {
            const s = String(e.source || e.from || e.src || '').trim();
            const t = String(e.target || e.to || e.dst || '').trim();
            if (!s || !t || s === t) continue;
            const key = s + '->' + t;
            if (drawn.has(key)) continue;
            drawn.add(key);
            group.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(0,0,0), new THREE.Vector3(0.1,0,0)]), edgeMat));
          }
        }
        const placed = new Map();
        const all = Array.from(new Set((nodes || []).map(n => String(n.label || n.id || n).replace(/</g,'&lt;').replace(/>/g,'&gt;')).filter(Boolean)));
        const limit = Math.min(all.length, 60);
        const placedGroup = new THREE.Group();
        group.add(placedGroup);
        for (let i = 0; i < limit; i++) {
          const label = all[i];
          const angle = (i / limit) * Math.PI * 2;
          const rr = R + (Math.random() - 0.5) * 0.6;
          const x = Math.cos(angle) * rr;
          const y = (Math.random() - 0.5) * 1.6;
          const z = Math.sin(angle) * rr;
          placed.set(label, new THREE.Vector3(x, y, z));
          const mesh = new THREE.Mesh(new THREE.SphereGeometry(nodeRadius, 24, 24), new THREE.MeshBasicMaterial({ color: new THREE.Color('#eaeaea'), transparent: true, opacity: 0.85 }));
          mesh.position.set(x, y, z);
          placedGroup.add(mesh);
        }
        placedGroup.add(new THREE.Mesh(new THREE.SphereGeometry(nodeRadius * 1.4, 32, 32), new THREE.MeshBasicMaterial({ color: new THREE.Color('#b8aaff'), transparent: true, opacity: 0.95 })));
        if (Array.isArray(edges)) {
          for (const e of edges.slice(0, 250)) {
            const s = String(e.source || e.from || e.src || '').trim();
            const t = String(e.target || e.to || e.dst || '').trim();
            const key = s + '->' + t;
            if (!s || !t || s === t || !drawn.has(key)) continue;
            const a = placed.get(s) || new THREE.Vector3(0,0,0);
            const b = placed.get(t) || new THREE.Vector3(0,0,0);
            const c = (a.distanceTo(new THREE.Vector3(0,0,0)) < 0.05) ? b : a;
            const d = (b.distanceTo(new THREE.Vector3(0,0,0)) < 0.05) ? a : b;
            placedGroup.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints([c, d]), edgeMat));
          }
        }
        return group;
      }

      function setState(state) {
        if (!scene) return;
        const orb = scene.getObjectByName('vyren-orb');
        if (!orb) return;
        const cfg = {
          IDLE: { color: '#7c6cff', intensity: 0.35, speed: 0.3 },
          LISTENING: { color: '#00d4ff', intensity: 0.75, speed: 0.8 },
          SPEAKING: { color: '#ffaa00', intensity: 0.7, speed: 0.6 },
          THINKING: { color: '#ffaa00', intensity: 0.5, speed: 0.45 },
          EXECUTING: { color: '#00ff88', intensity: 0.8, speed: 0.9 },
          INTERRUPTED: { color: '#ff4466', intensity: 0.9, speed: 1.2 },
          ERROR: { color: '#ff4466', intensity: 0.5, speed: 0.2 },
          OFFLINE: { color: '#3a3a4a', intensity: 0.15, speed: 0.15 }
        }[state] || { color: '#7c6cff', intensity: 0.35, speed: 0.3 };
        orb.children.forEach(child => {
          if (child.material && child.material.emissive) {
            child.material.emissive.set(cfg.color);
            child.material.emissiveIntensity = cfg.intensity;
          }
          if (child.material && child.material.color && child.type === 'MeshBasicMaterial') {
            child.material.color.set(cfg.color);
          }
        });
        orb.userData.speedTarget = cfg.speed;
      }

      function start() {
        if (envRunning) return;
        envRunning = true;
        if (!renderer) {
          renderer = new THREE.WebGLRenderer({ canvas: mainCanvas, antialias: true, alpha: true });
          renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
          renderer.setSize(mainCanvas.clientWidth || mainCanvas.width || 1, mainCanvas.clientHeight || mainCanvas.height || 1);
          renderer.toneMapping = THREE.ACESFilmicToneMapping;
          renderer.toneMappingExposure = 1.1;
          scene = new THREE.Scene();
          camera = new THREE.PerspectiveCamera(46, (mainCanvas.clientWidth || 1) / (mainCanvas.clientHeight || 1), 0.1, 60);
          camera.position.set(0, 0.1, 4.4);
          camera.lookAt(0, 0, 0);
          scene.add(new THREE.AmbientLight(0xffffff, 0.35));
          const dir = new THREE.DirectionalLight(0xffffff, 0.35);
          dir.position.set(2, 3, 3);
          scene.add(dir);

          const orb = makeOrb();
          orb.name = 'vyren-orb';
          scene.add(orb);

          const bg = new THREE.Group();
          bg.name = 'starfield';
          for (let i = 0; i < 700; i++) {
            const mesh = new THREE.Mesh(
              new THREE.SphereGeometry(0.005 + Math.random() * 0.018, 8, 8),
              new THREE.MeshBasicMaterial({ color: new THREE.Color('#ffffff'), transparent: true, opacity: 0.35 + Math.random() * 0.55 })
            );
            mesh.position.set((Math.random() - 0.5) * 22, (Math.random() - 0.5) * 14, -6 - Math.random() * 8);
            bg.add(mesh);
          }
          scene.add(bg);
        }
        document.getElementById('main').classList.add('canvas-active');
        const resize = () => {
          const w = mainCanvas.clientWidth || 1;
          const h = mainCanvas.clientHeight || 1;
          renderer.setSize(w, h, false);
          camera.aspect = w / Math.max(h, 1);
          camera.updateProjectionMatrix();
        };
        window.addEventListener('resize', resize);
        let time = 0;
        (function loop() {
          animId = requestAnimationFrame(loop);
          time += 0.016;
          const orb = scene.getObjectByName('vyren-orb');
          if (orb) {
            const sp = orb.userData.speedTarget || 0.3;
            orb.rotation.y += 0.004 * sp;
            let ring = null, ring2 = null;
            orb.children.forEach(child => {
              if (child.geometry && child.geometry.type === 'TorusGeometry') {
                if (!ring) ring = child; else ring2 = child;
              }
            });
            if (ring) { ring.rotation.z += 0.0025 * sp; ring.rotation.x += 0.0018 * sp; }
            if (ring2) { ring2.rotation.z -= 0.002 * sp; ring2.rotation.x -= 0.0015 * sp; }
            orb.position.y = Math.sin(time * 0.7) * 0.05;
          }
          const bg = scene.getObjectByName('starfield');
          if (bg) bg.rotation.y += 0.00015;
          renderer.render(scene, camera);
        })();
        setState('IDLE');
      }

      function stop() {
        envRunning = false;
        document.getElementById('main').classList.remove('canvas-active');
        if (animId) { cancelAnimationFrame(animId); animId = null; }
        if (renderer) { try { renderer.dispose(); } catch (e) { /* noop */ } renderer = null; }
        scene = null; camera = null;
      }

      function setMode(mode) {
        currentMode = mode;
        if (!scene) return;
        const existing = scene.getObjectByName('env-mode');
        if (existing) scene.remove(existing);
        if (mode === 'memory') scene.add(makeGraph(graphData.nodes, graphData.edges).setName && makeGraph(graphData.nodes, graphData.edges));
        if (mode === 'system') {
          const g = new THREE.Group(); g.name = 'env-mode';
          const pts = [];
          for (let i = 0; i < 70; i++) pts.push(new THREE.Vector3((Math.random()-0.5)*4, (Math.random()-0.5)*3, -1 - Math.random()*2));
          const geo = new THREE.BufferGeometry().setFromPoints(pts);
          g.add(new THREE.Points(geo, new THREE.PointsMaterial({ color: new THREE.Color('#00ff88'), size: 0.025, transparent: true, opacity: 0.55 })));
          scene.add(g);
        }
        if (mode === 'vision') {
          const g = new THREE.Group(); g.name = 'env-mode';
          g.add(new THREE.Mesh(new THREE.PlaneGeometry(2.2, 1.4), new THREE.MeshBasicMaterial({ color: new THREE.Color('#00d4ff'), transparent: true, opacity: 0.08, side: THREE.DoubleSide })));
          scene.add(g);
        }
        if (mode === 'activity') {
          const g = new THREE.Group(); g.name = 'env-mode';
          for (let i = 0; i < 35; i++) {
            const geo = new THREE.TorusGeometry(0.35 + Math.random() * 0.7, 0.012, 12, 80);
            const mesh = new THREE.Mesh(geo, new THREE.MeshBasicMaterial({ color: new THREE.Color('#ffaa00'), transparent: true, opacity: 0.25 }));
            mesh.rotation.set(Math.random()*3, Math.random()*3, Math.random()*3);
            g.add(mesh);
          }
          scene.add(g);
        }
      }

      function setGraphData(data) {
        graphData = data || { nodes: [], edges: [] };
        if (currentMode === 'memory') setMode('memory');
      }

      async function loadMemoryGraph() {
        try {
          const res = await fetch('/api/obsidian');
          const data = await res.json();
          const nodes = [];
          const edges = [];
          if (Array.isArray(data.entities)) for (const e of data.entities) nodes.push({ id: String(e.name || e.id || 'node'), label: String(e.name || e.id || 'node'), type: String(e.type || 'memory') });
          if (Array.isArray(data.relations)) for (const r of data.relations) edges.push({ source: String(r.source || r.from || ''), target: String(r.target || r.to || '') });
          if (!nodes.length) {
            setGraphData({ nodes: [
              { id: 'VYREN', label: 'VYREN', type: 'project' },
              { id: 'Gemini Live', label: 'Gemini Live', type: 'tool' },
              { id: 'Memory', label: 'Memory', type: 'system' },
              { id: 'NOVA', label: 'NOVA', type: 'project' },
              { id: 'Obsidian', label: 'Obsidian', type: 'tool' }
            ], edges: [
              { source: 'VYREN', target: 'Gemini Live' },
              { source: 'VYREN', target: 'Memory' },
              { source: 'VYREN', target: 'NOVA' },
              { source: 'NOVA', target: 'Obsidian' }
            ]});
            return;
          }
          setGraphData({ nodes, edges });
        } catch (e) {
          setGraphData({ nodes: [{ id: 'VYREN', label: 'VYREN', type: 'project' }], edges: [] });
        }
      }

      function interrupt() {
        setState('INTERRUPTED');
        setTimeout(() => setState('IDLE'), 1400);
      }

      async function selfImprove(query) {
        const q = String(query || 'improve current interface').trim();
        setState('THINKING');
        await new Promise(r => setTimeout(r, 250));
        try {
          const res = await fetch('/api/agent/tool', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tool: 'self_improve', args: { query: q } })
          });
          const data = await res.json();
          return data;
        } catch (e) {
          return { ok: false, error: String(e) };
        } finally {
          setState('IDLE');
        }
      }

      return { start, stop, setState, setMode, setGraphData, loadMemoryGraph, interrupt, selfImprove };
    })();
  </script>

  <script>
    // ── STATE (original, unchanged) ──
    let ws = null;
    let wsReconnectTimer = null;
    let currentState = 'INITIALIZING';
    let isMuted = false;
    let isSending = false;
    let lastVyrenEl = null;
    let vyrenTextBuffer = '';
    let metricsInterval = null;

    // ── ELEMENTS ──
    const $ = id => document.getElementById(id);
    const orb = $('orb');
    const orbLabel = $('orb-label');
    const stateLabel = $('state-label');
    const pillConn = $('pill-conn');
    const pillConnText = $('pill-conn-text');
    const waveformEl = $('waveform');
    const activityLog = $('activity-log-inline');
    const msgInput = $('msg-input');
    const sendBtn = $('send-btn');
    const muteBtn = $('mute-btn');
    const fsBtn = $('fs-btn');
    const dropZone = $('drop-zone');
    const fileInput = $('drop-zone-file-input');
    const reconnectBar = $('reconnecting-bar');

    // ── WAVEFORM BARS (36 bars) ──
    (function buildWaveform() {
      const count = 36;
      for (let i = 0; i < count; i++) {
        const bar = document.createElement('div');
        bar.className = 'bar';
        const t = 0.3 + Math.random() * 0.6;
        const hMin = 3 + Math.random() * 4;
        const hMax = 12 + Math.random() * 22;
        bar.style.cssText = `--d:${t}s;--h-min:${hMin}px;--h-max:${hMax}px;height:${hMin}px`;
        waveformEl.appendChild(bar);
      }
    })();

    // ── STATE MANAGEMENT ──
    const stateConfig = {
      INITIALIZING: { color: 'var(--txt-m)', dotClass: '', label: 'Initializing', orbText: '...', badge: 'initializing', waveform: false },
      LISTENING: { color: 'var(--cyan)', dotClass: 'live', label: 'Listening', orbText: '◉', badge: 'listening', waveform: true },
      SPEAKING: { color: 'var(--amber)', dotClass: 'warn', label: 'Speaking', orbText: '◉', badge: 'speaking', waveform: true, waveformClass: 'speaking' },
      THINKING: { color: 'var(--amber)', dotClass: 'warn', label: 'Thinking...', orbText: '...', badge: 'thinking', waveform: true, waveformClass: 'thinking' },
      MUTED: { color: 'var(--red)', dotClass: 'bad', label: 'Muted', orbText: 'MUTED', badge: 'muted', waveform: false },
      IDLE: { color: 'var(--signal)', dotClass: 'ok', label: 'Idle', orbText: '◉', badge: 'idle', waveform: false },
      DISCONNECTED: { color: 'var(--red)', dotClass: 'bad', label: 'Disconnected', orbText: '!', badge: 'disconnected', waveform: false }
    };

    function setChatState(state) {
      const cfg = stateConfig[state] || stateConfig.IDLE;
      currentState = state;

      orb.dataset.state = state;
      orbLabel.textContent = cfg.orbText;
      stateLabel.textContent = cfg.label;
      stateLabel.style.color = cfg.color;

      pillConn.className = 'tb-pill ' + (cfg.dotClass || '');
      pillConnText.textContent = cfg.badge;

      waveformEl.className = 'waveform';
      if (cfg.waveform) {
        waveformEl.classList.add('active');
        if (cfg.waveformClass) waveformEl.classList.add(cfg.waveformClass);
      }
    }

    window.setImmersiveState = function(state) {
      try { if (window.VyrenEnv && window.VyrenEnv.setState) window.VyrenEnv.setState(state); } catch (e) { /* noop */ }
    };

    const setState = setChatState;

    // ── WEBSOCKET (original, unchanged) ──
    function connect() {
      if (wsReconnectTimer) { clearTimeout(wsReconnectTimer); wsReconnectTimer = null; }
      const proto = location.protocol === 'https:' ? 'wss:' : 'ws:';
      const url = `${proto}//${location.host}/ws/chat`;
      try { ws = new WebSocket(url); } catch (e) { scheduleReconnect(); return; }

      ws.onopen = () => {
        reconnectBar.style.display = 'none';
        setChatState('IDLE');
        addLogMsg('system', 'Connected to VYREN.');
        startMetricsPoll();
      };

      ws.onclose = () => {
        reconnectBar.style.display = '';
        setChatState('DISCONNECTED');
        scheduleReconnect();
        stopMetricsPoll();
      };

      ws.onerror = () => { };

      ws.onmessage = (e) => {
        try { handleMessage(JSON.parse(e.data)); }
        catch (err) { console.warn('WS parse error', err); }
      };
    }

    function scheduleReconnect() {
      if (wsReconnectTimer) return;
      wsReconnectTimer = setTimeout(connect, 3000);
    }

    // ── MESSAGE HANDLING (original, unchanged) ──
    function handleMessage(data) {
      switch (data.type) {
        case 'state':
          if (data.state && stateConfig[data.state.toUpperCase()]) setState(data.state.toUpperCase());
          if (window.setImmersiveState) window.setImmersiveState(data.state || currentState);
          break;
        case 'user_transcript':
          addLogMsg('user', data.text);
          if (window.setImmersiveState) window.setImmersiveState('LISTENING');
          break;
        case 'chunk':
          setState('SPEAKING');
          appendToLastVyren(data.text);
          if (window.setImmersiveState) window.setImmersiveState('SPEAKING');
          break;
        case 'tool_call':
          addLogMsg('tool', `Tool: ${data.name}`);
          if (window.setImmersiveState) window.setImmersiveState('THINKING');
          break;
        case 'tool_result':
          addLogMsg('system', `${data.name}: ${data.result}`);
          break;
        case 'tool_declined':
          addLogMsg('system', `${data.name} declined.`);
          break;
        case 'confirmation_required':
          showConfirmation(data.name, data.args);
          break;
        case 'done':
          isSending = false;
          sendBtn.disabled = !msgInput.value.trim();
          removeTypingIndicator();
          if (currentState === 'SPEAKING' || currentState === 'THINKING') setState('IDLE');
          if (window.setImmersiveState) window.setImmersiveState('IDLE');
          lastVyrenEl = null;
          vyrenTextBuffer = '';
          break;
        case 'error':
          addLogMsg('system', 'Error: ' + data.message);
          isSending = false;
          sendBtn.disabled = !msgInput.value.trim();
          removeTypingIndicator();
          if (currentState === 'SPEAKING' || currentState === 'THINKING') setState('IDLE');
          if (window.setImmersiveState) window.setImmersiveState('IDLE');
          lastVyrenEl = null;
          vyrenTextBuffer = '';
          break;
        case 'system_msg':
          addLogMsg('system', data.system_msg);
          break;
        case 'log':
          addLogMsg('system', data.text);
          break;
        case 'metrics':
          if (data.cpu != null) updateBar('cpu', data.cpu);
          if (data.mem != null) updateBar('mem', data.mem);
          if (data.disk != null) updateBar('disk', data.disk);
          if (data.net != null) updateBar('net', data.net, true);
          break;
      }
    }

    // ── ACTIVITY LOG (original, unchanged) ──
    function addLogMsg(type, text) {
      removeTypingIndicator();
      const div = document.createElement('div');
      div.className = 'log-msg ' + type;
      if (type === 'user') div.innerHTML = `<span class="log-prefix">You</span>${esc(text)}`;
      else if (type === 'vyren') div.innerHTML = `<span class="log-prefix">VYREN</span>${formatVyrenText(text)}`;
      else div.textContent = text;
      activityLog.appendChild(div);
      scrollLog();
    }

    function appendToLastVyren(text) {
      vyrenTextBuffer += text;
      if (!lastVyrenEl) {
        removeTypingIndicator();
        lastVyrenEl = document.createElement('div');
        lastVyrenEl.className = 'log-msg vyren';
        activityLog.appendChild(lastVyrenEl);
      }
      lastVyrenEl.innerHTML = `<span class="log-prefix">VYREN</span>${formatVyrenText(vyrenTextBuffer)}`;
      scrollLog();
    }

    function showTypingIndicator() {
      if (document.querySelector('.typing-dots-wrap')) return;
      const div = document.createElement('div');
      div.className = 'typing-dots-wrap';
      div.innerHTML = '<div class="typing-dots"><span></span><span></span><span></span></div>';
      activityLog.appendChild(div);
      scrollLog();
    }

    function removeTypingIndicator() {
      const el = document.querySelector('.typing-dots-wrap');
      if (el) el.remove();
    }

    function showConfirmation(name, args) {
      const argStr = Object.entries(args || {}).map(([k, v]) => `${k}: ${v}`).join('\n');
      const div = document.createElement('div');
      div.className = 'log-msg confirm';
      div.innerHTML = `
    <div style="font-weight:600;margin-bottom:4px;font-size:13px">VYREN wants to:</div>
    <div style="font-family:var(--f-mono);font-size:11px;color:var(--amber);margin-bottom:4px">${esc(name)}</div>
    <div style="font-size:11px;white-space:pre-wrap;margin-bottom:8px">${esc(argStr)}</div>
    <div class="confirm-actions">
      <button class="btn-approve" data-approve="true">Allow</button>
      <button class="btn-decline" data-approve="false">Decline</button>
    </div>
  `;
      activityLog.appendChild(div);
      scrollLog();
      div.querySelectorAll('button').forEach(btn => {
        btn.addEventListener('click', () => {
          const approved = btn.dataset.approve === 'true';
          if (ws && ws.readyState === 1) ws.send(JSON.stringify({ type: 'confirmation', approved }));
          div.remove();
          addLogMsg('system', approved ? `${name} approved.` : `${name} declined.`);
        });
      });
    }

    function scrollLog() {
      requestAnimationFrame(() => { activityLog.scrollTop = activityLog.scrollHeight; });
    }

    function formatVyrenText(text) {
      return text
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/`(.+?)`/g, '<code>$1</code>')
        .replace(/\n/g, '<br>');
    }

    function esc(s) {
      if (!s) return '';
      const d = document.createElement('div');
      d.textContent = String(s);
      return d.innerHTML;
    }

    // ── SEND MESSAGE (original, unchanged) ──
    function sendMessage() {
      const text = msgInput.value.trim();
      if (!text || isSending) return;
      if (!ws || ws.readyState !== WebSocket.OPEN) {
        addLogMsg('system', 'Not connected. Reconnecting...');
        connect();
        return;
      }
      isSending = true;
      sendBtn.disabled = true;
      setState('THINKING');
      addLogMsg('user', text);
      msgInput.value = '';
      showTypingIndicator();
      ws.send(JSON.stringify({ type: 'message', text }));
    }

    msgInput.addEventListener('input', () => { sendBtn.disabled = !msgInput.value.trim() || isSending; });
    msgInput.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); } });
    sendBtn.addEventListener('click', sendMessage);
    document.getElementById('attach-btn').addEventListener('click', () => fileInput.click());

    // ── SYSTEM MONITOR (original, unchanged) ──
    function updateBar(id, value, isNet) {
      const valEl = $(id + '-val');
      const fillEl = $(id + '-fill');
      if (!valEl || !fillEl) return;
      let displayVal, width, color;
      if (isNet) {
        displayVal = value.toFixed(1) + ' MB/s';
        width = Math.min(value / 50 * 100, 100);
        color = 'var(--cyan)';
      } else {
        displayVal = Math.round(value) + '%';
        width = Math.min(value, 100);
        color = value > 90 ? 'var(--red)' : value > 75 ? 'var(--amber)' : 'var(--green)';
      }
      valEl.textContent = displayVal;
      fillEl.style.width = width + '%';
      fillEl.style.background = color;
      // mirror into dashboard page if present
      const dbEl = $('db-' + id);
      if (dbEl) dbEl.textContent = displayVal;
    }

    async function fetchStatus() {
      try {
        const r = await fetch('/api/system');
        const d = await r.json();
        if (d.cpu_percent != null) updateBar('cpu', d.cpu_percent);
        if (d.memory_percent != null) updateBar('mem', d.memory_percent);
        if (d.disk_percent != null) updateBar('disk', d.disk_percent);
        $('tools-val').textContent = (d.tool_count || 0) + ' loaded';
        $('mem-entries-val').textContent = (d.memory_entries || 0) + ' entries';
        $('uptime-val').textContent = d.uptime || '—';
        if ($('db-tools')) $('db-tools').innerHTML = (d.tool_count || 0) + '<small>loaded</small>';
        if ($('db-mem-entries')) $('db-mem-entries').innerHTML = (d.memory_entries || 0) + '<small>entries</small>';
        if ($('pill-mem')) $('pill-mem').textContent = (d.memory_entries || 0) + ' memories';
      } catch (e) { }
    }

    function startMetricsPoll() { fetchStatus(); metricsInterval = setInterval(fetchStatus, 2000); }
    function stopMetricsPoll() { if (metricsInterval) { clearInterval(metricsInterval); metricsInterval = null; } }

    // ── FILE DROP ZONE (original, unchanged) ──
    dropZone.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', (e) => { if (e.target.files.length > 0) handleFile(e.target.files[0]); });
    dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('drag-over'); });
    dropZone.addEventListener('dragleave', () => { dropZone.classList.remove('drag-over'); });
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('drag-over');
      if (e.dataTransfer.files.length > 0) handleFile(e.dataTransfer.files[0]);
    });

    function handleFile(file) {
      addLogMsg('system', `File selected: ${file.name} (${(file.size / 1024).toFixed(1)} KB)`);
      if (ws && ws.readyState === 1) {
        ws.send(JSON.stringify({ type: 'message', text: `[File: ${file.name}]` }));
        addLogMsg('user', `[Uploaded: ${file.name}]`);
      }
    }

    // ── MUTE TOGGLE (original, unchanged) ──
    function toggleMute() {
      isMuted = !isMuted;
      muteBtn.classList.toggle('active', isMuted);
      if (isMuted) {
        setState('MUTED');
        if (ws && ws.readyState === 1) ws.send(JSON.stringify({ type: 'mute', muted: true }));
      } else {
        setChatState('IDLE');
        if (ws && ws.readyState === 1) ws.send(JSON.stringify({ type: 'mute', muted: false }));
      }
    }
    muteBtn.addEventListener('click', toggleMute);

    // ── INTERRUPT / BARGE-IN ──
    const interruptBtn = document.getElementById('interrupt-btn');
    if (interruptBtn) {
      interruptBtn.addEventListener('click', () => {
        if (ws && ws.readyState === 1) {
          ws.send(JSON.stringify({ type: 'interrupt' }));
        }
        if (window.VyrenEnv && window.VyrenEnv.interrupt) window.VyrenEnv.interrupt();
        setState('INTERRUPTED');
        setTimeout(() => setState('IDLE'), 1200);
      });
    }

    // ── FULLSCREEN (original, unchanged) ──
    function toggleFullscreen() {
      if (!document.fullscreenElement) document.documentElement.requestFullscreen().catch(() => { });
      else document.exitFullscreen().catch(() => { });
    }
    fsBtn.addEventListener('click', toggleFullscreen);

    // ── KEYBOARD SHORTCUTS (original, unchanged) ──
    document.addEventListener('keydown', (e) => {
      if (document.activeElement === msgInput) {
        if (e.key === 'Escape') { msgInput.blur(); return; }
        return;
      }
      if (e.key === 'F4' || (e.key === 'm' || e.key === 'M')) { e.preventDefault(); toggleMute(); }
      if (e.key === 'F11') { e.preventDefault(); toggleFullscreen(); }
      if (e.key === 'i' || e.key === 'I') {
        const immersivePage = document.getElementById('page-immersive');
        if (immersivePage) immersivePage.classList.toggle('active');
      }
      if (e.key === 'Escape' && document.fullscreenElement) document.exitFullscreen().catch(() => { });
    });

    // ── SELF-IMPROVEMENT ──
    const selfImproveBtn = document.getElementById('self-improve-btn');
    const selfImproveInput = document.getElementById('self-improve-input');
    const selfImproveOutput = document.getElementById('self-improve-output');
    if (selfImproveBtn && selfImproveInput) {
      selfImproveBtn.addEventListener('click', async () => {
        const q = selfImproveInput.value.trim();
        if (!q) return;
        selfImproveOutput.textContent = 'Queued: ' + q;
        try {
          const r = await fetch('/api/self-improve', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ query: q }),
          });
          const data = await r.json();
          selfImproveOutput.textContent = JSON.stringify(data, null, 2);
        } catch (exc) {
          selfImproveOutput.textContent = 'Self-improve failed: ' + exc.message;
        }
      });
      if (selfImproveInput) {
        selfImproveInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') selfImproveBtn.click();
        });
      }
    }

    // ── SERVICE WORKER (original, unchanged) ──
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js').catch(() => { });
    }

    // ── URL / BROWSER PAGE ──
    async function ingestUrl() {
      const input = document.getElementById('url-input');
      const status = document.getElementById('url-status');
      const content = document.getElementById('url-content');
      const graphEl = document.getElementById('url-graph');
      const url = (input && input.value || '').trim();
      if (!url) {
        if (status) status.textContent = 'Enter a URL first.';
        return;
      }
      if (status) status.textContent = 'Ingesting...';
      try {
        const r = await fetch('/api/url/ingest', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url })
        });
        const data = await r.json();
        if (content) {
          content.textContent = JSON.stringify(data, null, 2);
        }
        if (graphEl) {
          graphEl.textContent = 'Graph updated. Open the Graph page to visualize.';
        }
        if (status) status.textContent = `Ingested: ${data.status || 'done'}`;
      if (content) {
        const safe = JSON.stringify(data, null, 2);
        content.textContent = safe;
        if (data.images && data.images.length) {
          const imgs = data.images.slice(0, 6).map(src => `<img src="${src}" style="max-height:120px;border-radius:8px;border:1px solid var(--border);margin:4px">`).join('');
          content.innerHTML = `<div style="margin-bottom:8px">${imgs}</div><pre style="white-space:pre-wrap;font-size:12px;color:var(--txt-m)">${esc(safe)}</pre>`;
        }
      }
      } catch (exc) {
        if (status) status.textContent = 'Ingest failed: ' + exc.message;
      }
    }

    function openUrl() {
      const input = document.getElementById('url-input');
      const url = (input && input.value || '').trim();
      if (!url) return;
      window.open(url, '_blank');
    }

    const urlIngestBtn = document.getElementById('url-ingest-btn');
    const urlOpenBtn = document.getElementById('url-open-btn');
    if (urlIngestBtn) urlIngestBtn.addEventListener('click', ingestUrl);
    if (urlOpenBtn) urlOpenBtn.addEventListener('click', openUrl);

    // URL page helpers: media preview + graph refresh after ingest
    async function refreshUrlGraph() {
      const graphEl = document.getElementById('url-graph');
      if (!graphEl) return;
      try {
        const res = await fetch('/api/graph');
        const data = await res.json();
        const websites = (data.nodes || []).filter(n => n.type === 'website' || (n.properties && n.properties.url));
        graphEl.innerHTML = websites.slice(0, 20).map(n => `<div><a href="${n.properties.url || n.label}" target="_blank">${n.label}</a></div>`).join('') || '<div style="color:var(--txt-m)">No URL nodes yet.</div>';
      } catch (exc) {
        graphEl.textContent = 'Graph refresh failed.';
      }
    }

    const origIngestUrl = ingestUrl;
    window.ingestUrl = async function() {
      await origIngestUrl();
      await refreshUrlGraph();
    };

    const urlInput = document.getElementById('url-input');
    if (urlInput) {
      urlInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') window.ingestUrl();
      });
    }

    // ── GRAPH PAGE ──
    (function initGraphPage() {
      const container = document.getElementById('graph-canvas');
      if (!container || typeof vis === 'undefined') return;

      async function loadGraph(source) {
        const res = await fetch(source || '/api/graph');
        const data = await res.json();
        renderGraph(data);
        if (window.updateGraphNodes) window.updateGraphNodes('');
      }

      function renderGraph(data) {
        const nodes = new vis.DataSet((data.nodes || []).map(n => ({
          id: n.id,
          label: n.label,
          title: n.type,
          group: n.type,
          value: n.importance || 1
        })));

        const edges = new vis.DataSet((data.links || []).map(l => ({
          from: l.source,
          to: l.target,
          label: l.relation
        })));

        if (!window.__vyrenGraph) {
          window.__vyrenGraph = new vis.Network(container, { nodes, edges }, {
            physics: { stabilization: true },
            interaction: { hover: true }
          });

          window.__vyrenGraph.on('click', (params) => {
            if (!params.nodes.length) return;
            const nodeId = params.nodes[0];
            const node = (data.nodes || []).find(n => n.id === nodeId);
            const sel = document.getElementById('graph-selection');
            if (!node || !sel) return;
            const props = Object.entries(node.properties || {})
              .filter(([, v]) => v)
              .map(([k, v]) => `${k}: ${v}`)
              .join('<br>');
            sel.innerHTML = `<b>${node.label}</b><br><span style="color:var(--txt-m)">${node.type}</span><br><br>${props ? props : ''}`;
          });
        } else {
          window.__vyrenGraph.setData({ nodes, edges });
        }

        const statsEl = document.getElementById('graph-stats');
        if (statsEl && data.stats) {
          statsEl.innerHTML = `
            <div><b>${data.stats.entities}</b> entities</div>
            <div><b>${data.stats.edges}</b> edges</div>
            <div>${Object.entries(data.stats.types || {}).map(([k, v]) => `<span class="pill">${k}: ${v}</span>`).join(' ')}</div>
          `;
        }
      }

      const searchInput = document.getElementById('graph-search');
      if (searchInput) {
        searchInput.addEventListener('keydown', async (e) => {
          if (e.key !== 'Enter') return;
          const q = searchInput.value.trim();
          if (!q || !window.__vyrenGraph) return;
          const res = await fetch(`/api/graph/search?q=${encodeURIComponent(q)}&limit=20`);
          const data = await res.json();
          const first = (data.results || [])[0];
          if (first) {
            window.__vyrenGraph.selectNodes([first.id]);
            window.__vyrenGraph.focus(first.id, { scale: 1.5 });
          }
        });
      }

      const refreshBtn = document.getElementById('graph-refresh');
      if (refreshBtn) {
        refreshBtn.addEventListener('click', () => loadGraph('/api/graph'));
      }

      fetch('/api/obsidian')
        .then(r => r.json())
        .then(data => {
          if ((data.nodes || []).length) {
            renderGraph(data);
            return;
          }
          loadGraph();
        })
        .catch(() => loadGraph());
    })();

    // ── INIT ──
    setState('INITIALIZING');
    connect();

    // ── IMMERSIVE 3D ENGINE ──
    let immersiveReady = false;
    let immersiveState = 'IDLE';

    window.setImmersiveState = function(state) {
      immersiveState = state || 'IDLE';
      const hud = document.getElementById('immersive-state');
      if (hud) hud.textContent = immersiveState.toUpperCase();
      if (window.updateOrbVisualState) window.updateOrbVisualState(immersiveState);
    };

    window.initImmersive = function() {
      if (immersiveReady || typeof THREE === 'undefined') return;
      try {
        const page = document.getElementById('page-immersive');
        const canvas = document.getElementById('immersive-canvas');
        if (!page || !canvas) return;

        const measure = () => {
          const r = canvas.getBoundingClientRect();
          return { w: r.width || window.innerWidth || window.innerWidth, h: r.height || window.innerHeight || window.innerHeight };
        };
        const size = measure();

        const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.setSize(size.w, size.h, false);
        renderer.outputColorSpace = THREE.SRGBColorSpace;

        const scene = new THREE.Scene();
        scene.background = new THREE.Color(0x05050a);
        scene.fog = new THREE.Fog(0x05050a, 8, 30);

        const camera = new THREE.PerspectiveCamera(50, size.w / Math.max(size.h, 1), 0.1, 200);
        camera.position.z = 6;

        const ambient = new THREE.AmbientLight(0x8090a0, 0.9);
        scene.add(ambient);
        const point = new THREE.PointLight(0x7c6cff, 1.1, 40);
        point.position.set(4, 3, 6);
        scene.add(point);

        const starsGeo = new THREE.BufferGeometry();
        const starsCount = 800;
        const starsPos = new Float32Array(starsCount * 3);
        for (let i = 0; i < starsCount; i++) {
          const r = 14 + Math.random() * 20;
          const theta = Math.random() * Math.PI * 2;
          const phi = Math.acos(2 * Math.random() - 1);
          starsPos[i*3+0] = r * Math.sin(phi) * Math.cos(theta);
          starsPos[i*3+1] = r * Math.sin(phi) * Math.sin(theta);
          starsPos[i*3+2] = r * Math.cos(phi);
        }
        starsGeo.setAttribute('position', new THREE.BufferAttribute(starsPos, 3));
        const starsMat = new THREE.PointsMaterial({ color: 0xffffff, size: 0.02, transparent: true, opacity: 0.6 });
        const stars = new THREE.Points(starsGeo, starsMat);
        scene.add(stars);

        const coreGeo = new THREE.SphereGeometry(1.05, 64, 64);
        const coreMat = new THREE.MeshPhysicalMaterial({
          color: 0x181826,
          emissive: 0x04040b,
          roughness: 0.18,
          metalness: 0.12,
          clearcoat: 0.6,
          clearcoatRoughness: 0.15,
        });
        const core = new THREE.Mesh(coreGeo, coreMat);
        scene.add(core);

        const shellGeo = new THREE.SphereGeometry(1.22, 64, 64);
        const shellMat = new THREE.MeshPhysicalMaterial({
          color: 0x000000,
          emissive: 0x000000,
          roughness: 0.05,
          metalness: 0.0,
          transmission: 0.55,
          thickness: 0.25,
          transparent: true,
          opacity: 0.22,
        });
        const shell = new THREE.Mesh(shellGeo, shellMat);
        scene.add(shell);

        const ringGeo = new THREE.TorusGeometry(1.65, 0.02, 16, 120);
        const ringMat = new THREE.MeshBasicMaterial({ color: 0x00d4ff, transparent: true, opacity: 0.25 });
        const ring = new THREE.Mesh(ringGeo, ringMat);
        ring.rotation.x = 1.15;
        ring.rotation.y = 0.45;
        scene.add(ring);

        const ring2Geo = new THREE.TorusGeometry(1.9, 0.015, 16, 140);
        const ring2Mat = new THREE.MeshBasicMaterial({ color: 0x7c6cff, transparent: true, opacity: 0.18 });
        const ring2 = new THREE.Mesh(ring2Geo, ring2Mat);
        ring2.rotation.x = -0.6;
        ring2.rotation.y = 0.9;
        scene.add(ring2);

        window.updateOrbVisualState = function(state) {
          const s = (state || 'IDLE').toLowerCase();
          if (s === 'listening') {
            coreMat.emissive.setHex(0x001418);
            shellMat.opacity = 0.28;
            point.color.setHex(0x00ff88);
            point.intensity = 1.4;
          } else if (s === 'thinking') {
            coreMat.emissive.setHex(0x1a0f28);
            shellMat.opacity = 0.32;
            point.color.setHex(0x7c6cff);
            point.intensity = 1.8;
          } else if (s === 'speaking') {
            coreMat.emissive.setHex(0x051018);
            shellMat.opacity = 0.35;
            point.color.setHex(0x00d4ff);
            point.intensity = 1.6;
          } else {
            coreMat.emissive.setHex(0x04040b);
            shellMat.opacity = 0.22;
            point.color.setHex(0x7c6cff);
            point.intensity = 1.1;
          }
        };

        scene.userData = { camera, renderer, orbitSpeed: 0.003 };

        let graphNodesGroup = new THREE.Group();
        scene.add(graphNodesGroup);

        window.updateGraphNodes = async function(query) {
          try {
            const res = await fetch('/api/graph?q=' + encodeURIComponent(query || ''));
            const data = await res.json();
            while (graphNodesGroup.children.length) graphNodesGroup.remove(graphNodesGroup.children[0]);
            const nodes = data.nodes || [];
            const links = data.links || [];
            const positions = new Map();
            const sphere = new THREE.SphereGeometry(0.06, 16, 16);
            const mat = new THREE.MeshBasicMaterial({ color: 0x00d4ff });
            nodes.forEach((n, i) => {
              const m = new THREE.Mesh(sphere, mat.clone());
              const phi = Math.acos(-1 + (2 * i) / Math.max(nodes.length, 1));
              const theta = Math.sqrt(nodes.length * Math.PI) * phi;
              const r = 2.4 + (n.importance || 1) * 0.3;
              m.position.setFromSphericalCoords(r, phi, theta);
              graphNodesGroup.add(m);
              positions.set(String(n.id), m.position.clone());
            });
            const lineMat = new THREE.LineBasicMaterial({ color: 0x7c6cff, transparent: true, opacity: 0.25 });
            links.forEach(l => {
              const a = positions.get(String(l.source));
              const b = positions.get(String(l.target));
              if (!a || !b) return;
              const geom = new THREE.BufferGeometry().setFromPoints([a, b]);
              graphNodesGroup.add(new THREE.Line(geom, lineMat));
            });
          } catch (e) {
            console.warn('graph nodes failed', e);
          }
        };

        window.updateGraphNodes('VYREN');

        (function initGraph() {
          if (!document.getElementById('graph-canvas')) return;
          const canvas = document.getElementById('graph-canvas');
          const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
          renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
          const setSize = () => {
            const w = canvas.clientWidth || window.innerWidth;
            const h = canvas.clientHeight || window.innerHeight;
            renderer.setSize(w, h, false);
            camera.aspect = w / h;
            camera.updateProjectionMatrix();
          };
          setSize();
          const graphScene = new THREE.Scene();
          const axes = new THREE.AxesHelper(2);
          graphScene.add(axes);
          (function loop() {
            requestAnimationFrame(loop);
            renderer.render(graphScene, camera);
          })();
        })();

        (function initMouseControls() {
          const canvas = document.getElementById('immersive-canvas');
          if (!canvas) return;
          let dragging = false;
          let prev = { x: 0, y: 0 };
          canvas.addEventListener('pointerdown', e => { dragging = true; prev = { x: e.clientX, y: e.clientY }; });
          canvas.addEventListener('pointermove', e => {
            if (!dragging) return;
            const dx = e.clientX - prev.x;
            const dy = e.clientY - prev.y;
            core.rotation.y += dx * 0.005;
            core.rotation.x += dy * 0.005;
            ring.rotation.z += dx * 0.003;
            ring2.rotation.z -= dx * 0.002;
            prev = { x: e.clientX, y: e.clientY };
          });
          canvas.addEventListener('pointerup', () => { dragging = false; });
          canvas.addEventListener('wheel', (e) => {
            camera.position.z = Math.max(3.2, Math.min(12, camera.position.z + e.deltaY * 0.005));
          }, { passive: true });
        })();

        let handMesh = null;
        let handVisible = false;
        let handTarget = null;

        function showHandVisualization() {
          if (handMesh) return;
          const geo = new THREE.SphereGeometry(0.08, 16, 16);
          const mat = new THREE.MeshBasicMaterial({ color: 0x00ff88, transparent: true, opacity: 0.9 });
          handMesh = new THREE.Mesh(geo, mat);
          scene.add(handMesh);
        }

        function updateHandVisualization(x, y, z) {
          if (!handMesh) showHandVisualization();
          handVisible = true;
          handMesh.position.set(x || 0, y || 0, z || 0);
          handMesh.material.opacity = 0.9;
        }

        function hideHandVisualization() {
          if (!handMesh) return;
          handVisible = false;
          handMesh.material.opacity = 0;
        }

        async function initHandTracking() {
          try {
            if (!('mediaDevices' in navigator && 'getUserMedia' in navigator.mediaDevices)) return;
            const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user', width: 320, height: 240 } });
            const video = document.createElement('video');
            video.srcObject = stream;
            video.play();
            const handPose = new Hands({ locateFile: (file) => 'https://cdn.jsdelivr.net/npm/@mediapipe/hands/' });
            handPose.setOptions({ maxNumHands: 1, modelComplexity: 1, minDetectionConfidence: 0.6, minTrackingConfidence: 0.6 });
            handPose.onResults((results) => {
              if (!document.getElementById('page-immersive').classList.contains('active')) {
                hideHandVisualization();
                return;
              }
              if (results.multiHandLandmarks && results.multiHandLandmarks.length) {
                const lm = results.multiHandLandmarks[0];
                const tip = lm[8];
                updateHandVisualization((tip.x - 0.5) * -6, (tip.y - 0.5) * 6, -2);
              } else {
                hideHandVisualization();
              }
            });
            (async () => {
              while (true) {
                await handPose.send({ image: video });
                await new Promise(r => setTimeout(r, 120));
              }
            })();
          } catch (e) {
            console.warn('hand tracking unavailable', e);
          }
        }

        setTimeout(initHandTracking, 1500);

        window.addEventListener('resize', () => {
          const canvas = document.getElementById('immersive-canvas');
          if (!canvas) return;
          const w = canvas.clientWidth;
          const h = canvas.clientHeight;
          camera.aspect = w / h;
          camera.updateProjectionMatrix();
          renderer.setSize(w, h, false);
        });

        function animate() {
          if (!document.getElementById('page-immersive').classList.contains('active')) {
            requestAnimationFrame(animate);
            return;
          }
          const t = Date.now() * 0.001;
          const s = immersiveState || 'IDLE';
          if (s === 'thinking') {
            ring.rotation.z += 0.008;
            ring2.rotation.z -= 0.006;
            core.scale.setScalar(1 + 0.01 * Math.sin(t * 6));
          } else if (s === 'speaking') {
            ring.rotation.z += 0.004;
            core.scale.setScalar(1 + 0.006 * Math.sin(t * 10));
          } else if (s === 'listening') {
            ring.rotation.z += 0.005;
            core.scale.setScalar(1 + 0.004 * Math.sin(t * 2));
          } else {
            ring.rotation.z += 0.002;
            ring2.rotation.z += 0.0015;
            core.scale.setScalar(1 + 0.004 * Math.sin(t));
          }
          point.position.x = Math.cos(t * 0.7) * 4;
          point.position.y = Math.sin(t * 0.5) * 2;
          point.position.z = 5 + Math.sin(t * 0.3);
          renderer.render(scene, camera);
          requestAnimationFrame(animate);
        }
        animate();
        immersiveReady = true;
      } catch (e) {
        console.warn('Immersive init failed', e);
      }
    };

    window.addEventListener('resize', () => {
      const page = document.getElementById('page-immersive');
      if (!page || !page.classList.contains('active')) return;
      initImmersive();
    });

    // Route immersive key
    window.addEventListener('keydown', (e) => {
      const immersivePage = document.getElementById('page-immersive');
      if (!immersivePage) return;
      if (e.key.toLowerCase() === 'i' && document.activeElement && document.activeElement.tagName !== 'INPUT') {
        immersivePage.classList.toggle('active');
        if (immersivePage.classList.contains('active')) initImmersive();
      }
    });

    (function initPagePanels() {
      async function api(path, opts) {
        try {
          const r = await fetch(path, opts || {});
          if (!r.ok) throw new Error('HTTP ' + r.status);
          return await r.json();
        } catch (exc) {
          return { error: String(exc) };
        }
      }

      function setText(id, text) {
        const el = document.getElementById(id);
        if (el) el.textContent = text || '';
      }

      // Memory page: load dynamic contents instead of hardcoded items.
      async function refreshMemoryPage() {
        const data = await api('/api/memory');
        const list = (Array.isArray(data) ? data : []).slice(0, 40);
        const pinned = list.filter(x => x.pinned);
        const long = list.filter(x => !x.pinned).slice(0, 30);
        const pinnedEl = document.getElementById('mem-pinned-list');
        const longEl = document.getElementById('mem-long-list');
        const recentEl = document.getElementById('mem-recent-list');
        setText('mem-pinned-cnt', String(pinned.length));
        setText('mem-long-cnt', String(long.length));
        setText('mem-recent-cnt', String(list.length));
        setText('mem-total', String(list.length));
        if (pinnedEl) pinnedEl.innerHTML = pinned.map(x => `<div class="mem-chip"><span class="dot"></span>${esc(x.key || '')}: ${esc(x.value || '')}</div>`).join('') || '<div class="mem-chip"><span class="dot"></span>No pinned memories.</div>';
        if (longEl) longEl.innerHTML = long.map(x => `<div class="mem-chip"><span class="dot"></span>${esc(x.key || '')}: ${esc(x.value || '')}</div>`).join('') || '<div class="mem-chip"><span class="dot"></span>No long-term memories.</div>';
        if (recentEl) recentEl.innerHTML = list.slice(0, 8).map(x => `<div class="mem-chip"><span class="dot"></span>${esc(x.key || '')}: ${esc(x.value || '')}</div>`).join('') || '<div class="mem-chip"><span class="dot"></span>No recent memories.</div>';
      }

      const memSearchBtn = document.getElementById('mem-search-btn');
      if (memSearchBtn) memSearchBtn.addEventListener('click', refreshMemoryPage);
      const memSearchInput = document.getElementById('mem-search-input');
      if (memSearchInput) memSearchInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') refreshMemoryPage(); });

      // Vision: wired control
      const visionBtn = document.getElementById('vision-enable-btn');
      const visionStatus = document.getElementById('vision-status');
      if (visionBtn && visionStatus) {
        visionBtn.addEventListener('click', async () => {
          const wantEnable = visionBtn.textContent.toLowerCase().includes('enable');
          visionStatus.textContent = 'Updating...';
          const data = await api('/api/vision/toggle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ enabled: !wantEnable }),
          });
          if (data && data.enabled) {
            visionBtn.textContent = 'Disable vision';
            visionStatus.textContent = 'Vision enabled for this session.';
          } else {
            visionBtn.textContent = 'Enable vision';
            visionStatus.textContent = 'Vision disabled.';
          }
        });
      }

      // Dashboard: live refresh
      async function refreshDashboard() {
        try {
          const sys = await api('/api/system');
          if (sys.cpu_percent != null) updateBar('cpu', sys.cpu_percent);
          if (sys.memory_percent != null) updateBar('mem', sys.memory_percent);
          if (sys.disk_percent != null) updateBar('disk', sys.disk_percent);
          const dbConn = document.getElementById('db-conn');
          if (dbConn) dbConn.textContent = sys.connectivity || 'connecting';
          const dbMem = document.getElementById('db-mem-entries');
          if (dbMem) dbMem.innerHTML = (sys.memory_entries || 0) + '<small>entries</small>';
          const dbTools = document.getElementById('db-tools');
          if (dbTools) dbTools.innerHTML = (sys.tool_count || 0) + '<small>loaded</small>';
        } catch (e) { }
      }

      // Developer page: live logs
      async function refreshDeveloper() {
        try {
          const data = await api('/api/audit?limit=20');
          const el = document.getElementById('dev-errors');
          if (!el) return;
          const lines = (data && Array.isArray(data.entries) ? data.entries : []).slice(-20);
          el.innerHTML = lines.map(line => `<div class="log-line"><span class="lt">${new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</span><span class="lm">${esc(line)}</span></div>`).join('');
        } catch (e) { }
      }

      // Mobile bottom nav
      function activateBottomNav(page) {
        document.querySelectorAll('.bnav-item').forEach(el => el.classList.toggle('active', el.dataset.page === page));
      }

      document.querySelectorAll('.bnav-item').forEach(btn => {
        btn.addEventListener('click', () => setActivePage(btn.dataset.page));
      });

      // Battery + quick actions
      async function refreshBattery() {
        const data = await api('/api/battery');
        const el = document.getElementById('battery-pct');
        if (!el) return;
        el.textContent = data && data.available ? data.percent + '%' : '—';
        if (data && data.available) {
          const status = document.getElementById('battery-status');
          if (status) status.textContent = data.charging ? 'Charging' : 'On battery';
        }
      }

      const interval = setInterval(() => {
        if (!document.getElementById('page-dashboard') && !document.getElementById('page-chats')) return;
        refreshDashboard();
        refreshMemoryPage();
        refreshDeveloper();
        refreshBattery();
      }, 3000);
      refreshDashboard();
      refreshMemoryPage();
      refreshDeveloper();
      refreshBattery();
    })();

    (function initSpeechControls() {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SpeechRecognition) return;
      const recognition = new SpeechRecognition();
      recognition.continuous = false;
      recognition.interimResults = false;
      recognition.lang = 'en-US';

      const msgInput = document.getElementById('msg-input');
      const sendBtn = document.getElementById('send-btn');
      const voiceStatus = document.getElementById('voice-status');
      const ttsBtn = document.getElementById('tts-read-btn');

      function setVoiceStatus(text, mode) {
        if (voiceStatus) voiceStatus.textContent = text;
        document.querySelectorAll('.mic-btn').forEach(btn => {
          btn.classList.toggle('listening', mode === 'listening');
          btn.classList.toggle('speaking', mode === 'speaking');
        });
      }

      document.querySelectorAll('[data-mic="true"]').forEach(btn => {
        btn.addEventListener('click', () => {
          if (!('SpeechRecognition' in window || 'webkitSpeechRecognition' in window)) {
            addLogMsg('system', 'Speech input not supported in this browser.');
            return;
          }
          try {
            recognition.start();
            setVoiceStatus('Listening...', 'listening');
          } catch (e) {
            setVoiceStatus('Mic error', 'idle');
          }
        });
      });

      recognition.onresult = (event) => {
        const text = event.results[0][0].transcript;
        if (msgInput) msgInput.value = text;
        if (sendBtn) sendBtn.disabled = !text.trim();
        setVoiceStatus('Voice ready', 'idle');
        sendMessage();
      };

      recognition.onerror = () => setVoiceStatus('Mic error', 'idle');
      recognition.onend = () => setVoiceStatus('Voice ready', 'idle');

      // Simple assistant reply readback using available speech APIs if present.
      const origHandleMessage = window.handleMessage || function() {};
      window.handleMessage = function(data) {
        try { origHandleMessage(data); } catch (e) { /* noop */ }
        if (!data) return;
        if (data.type === 'chunk' && 'speechSynthesis' in window) {
          window.speechSynthesis.cancel();
          const utter = new SpeechSynthesisUtterance(data.text || '');
          utter.rate = 1.05;
          utter.pitch = 1.0;
          window.speechSynthesis.speak(utter);
        }
      };
    })();

  </script>
</body>

</html>