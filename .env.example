# VYREN Environment Variables
# Copy this file to .env and fill in your keys.

# REQUIRED for Gemini Live (primary and only voice mode)
GEMINI_API_KEY=your_key_here

# No GEMINI_API_KEY? Voice falls back to local pyttsx3 TTS (no key needed)
# and auto-recovers to Gemini Live once a key + internet are available.

# Optional — customize model
VYREN_MODEL=gemini-2.5-flash

# Optional — model used by the mobile realtime voice channel (/ws/live/mobile)
VYREN_MOBILE_MODEL=gemini-3.1-flash-live-preview