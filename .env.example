# VYREN — Environment Variables
# Copy this to .env and fill in your values. Never commit .env.

# Required: Google Gemini API key
# Get one at https://aistudio.google.com/apikey (free tier available)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override the model name
# VYREN_MODEL=gemini-2.5-flash

# Optional: Offline model (Ollama)
# Install Ollama from ollama.com, pull a model, and VYREN auto-falls back
# VYREN_OLLAMA_MODEL=llama3.1

# Optional: Voice — Speech-to-Text (Deepgram)
# Get a key at https://console.deepgram.com (free tier available)
# DEEPGRAM_API_KEY=

# Optional: Voice — Text-to-Speech (ElevenLabs)
# Get a key at https://elevenlabs.io (free tier available)
# ELEVENLABS_API_KEY=

# Optional: Override ElevenLabs voice
# VYREN_VOICE=21m00Tcm4TlvDq8ikWAM  # Rachel (default)